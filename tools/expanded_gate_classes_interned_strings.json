{
 "version": 1,
 "definitions": {
  "interned-domain-capture": {
   "kind": "intended",
   "description": "InternedStrings/P5 S0 (A-Domain, IF-Capture): the hand-written `data.dictionaries.literal(col, s)` lets and their `__cq_parameter_N = &x` bindings are replaced by host-once A-Domain captures `let __cq_capture_N: StringCode = ::cq_storage::domain::exact(&(dictionaries.domain(col)), &(s)); let __cq_c_N = &__cq_capture_N;`; relational comparisons read __cq_c_N instead of __cq_parameter_N (renumbered); same codes, same predicates and operator order"
  },
  "interned-renumber": {
   "kind": "refactor",
   "description": "InternedStrings renumbering only: inserted capture bindings shift generated ordinals (__cq_parameter_N, __cq_rN_*, __cq_generated_N, ...); token streams equal modulo these ordinals"
  },
  "interned-h19-where": {
   "kind": "intended",
   "description": "P5 S0 retail_h19: the opaque Rust `if` over code lets becomes one relational `where` over A-Domain captures and closed Decimal bounds; the plan and realization change (selection before the part join, no part_key fallback HashIndex), measured by exactness and paired timing"
  },
  "interned-typed": {
   "kind": "intended",
   "description": "InternedStrings typed_* workloads: text columns are interned at load through a generated loader (`intern(.., &mut dictionaries)`) and decoded once at publication (`dictionaries.publish(col, code)`) instead of query-time `to_string`"
  }
 },
