physical { relation R (first : i32 , second : i32);
 relation S (first : i32 , second : i32);
 relation T (first : i32 , second : i32);
 relation U (first : i32 , second : i32);
 r0 = pipe rename R@0 { first - > a , second - > b };
 r1 = pipe rename S@1 { first - > b , second - > c };
 r2 = pipe probe first [b] r0 , r1;
 r3 = pipe rename T@2 { first - > c , second - > d };
 r4 = pipe probe first [c] r2 , r3;
 r5 = pipe rename U@3 { first - > d , second - > a };
 r6 = pipe probe first [a , d] r4 , r5;
 r7 = pipe canon project r6 keep { a , c };
 return r7 as answer (a , c);
 }
