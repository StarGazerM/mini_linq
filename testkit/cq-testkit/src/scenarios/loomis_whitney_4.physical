physical { relation ABC (first : i32 , second : i32 , third : i32);
 relation BCD (first : i32 , second : i32 , third : i32);
 relation ACD (first : i32 , second : i32 , third : i32);
 relation ABD (first : i32 , second : i32 , third : i32);
 r0 = pipe rename ABC@0 { first - > a , second - > b , third - > c };
 r1 = pipe rename BCD@1 { first - > b , second - > c , third - > d };
 r2 = pipe probe first [b , c] r0 , r1;
 r3 = pipe rename ACD@2 { first - > a , second - > c , third - > d };
 r4 = pipe probe first [a , c , d] r2 , r3;
 r5 = pipe rename ABD@3 { first - > a , second - > b , third - > d };
 r6 = pipe probe first [a , b , d] r4 , r5;
 r7 = pipe canon project r6 keep { a , b , c , d };
 return r7 as answer (a , b , c , d);
 }
