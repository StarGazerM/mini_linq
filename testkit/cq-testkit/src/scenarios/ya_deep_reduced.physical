physical { relation R (first : i32 , second : i32);
 relation S (first : i32 , second : i32);
 relation T (first : i32 , second : i32);
 relation U (first : i32 , second : i32);
 r0 = pipe rename S@1 { first - > b , second - > c };
 r1 = pipe rename R@0 { first - > a , second - > b };
 r2 = let semi eager [b] r0 , r1;
 r3 = pipe rename T@2 { first - > c , second - > d };
 r4 = let semi eager [c] r3 , r2;
 r5 = pipe rename U@3 { first - > d , second - > e };
 r6 = let semi eager [d] r5 , r4;
 r7 = let semi eager [d] r4 , r6;
 r8 = let semi eager [c] r2 , r7;
 r9 = pipe semi eager [b] r1 , r8;
 r10 = pipe probe first [b] r9 , r8;
 r11 = pipe probe first [c] r10 , r7;
 r12 = pipe probe first [d] r11 , r6;
 r13 = pipe canon project r12 keep { a , e };
 return r13 as answer (a , e);
 }
