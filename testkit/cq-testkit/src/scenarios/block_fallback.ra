relational {relation P(x:i32); relation R(x:i32,y:i32); relation S(x:i32,y:i32);
p=rename P@0{x->x}; r0=rename R@1.0.0{x->x,y->y}; r1=project r0 keep{x,y};
s0=rename S@1.1.0{x->x,y->y}; s1=project s0 keep{x,y}; a=anti[x]s1,r1;
u=union r1,a block @1 free[x] interface[y] fallback;
j=natural_join p with u; out=project j keep{x,y}; output out as answer(x,y);}
