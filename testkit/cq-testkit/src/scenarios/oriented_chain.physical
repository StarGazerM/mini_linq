physical { relation Edge (src : i32 , dst : i32);
 r0 = pipe rename Edge@0 { src - > a , dst - > b };
 r1 = pipe rename Edge@1 { src - > b , dst - > c };
 r2 = pipe probe first [b] r0 , r1;
 r3 = pipe rename Edge@2 { src - > d , dst - > c };
 r4 = pipe probe first [c] r2 , r3;
 r5 = pipe canon project r4 keep { a , d };
 return r5 as answer (a , d);
 }
