relational {
    relation R(first: i32, second: i32, value: i32);
    relation S(first: i32, second: i32, value: i32);
    r0 = rename R@0 { first -> a, second -> b, value -> x };
    r1 = rename S@1 { first -> b, second -> a, value -> y };
    r2 = natural_join r0 with r1;
    r3 = project r2 keep { x, y };
    output r3 as answer(x, y);
}
