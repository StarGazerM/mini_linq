relational {
    relation D(driver_id: i32, depot_id: i32);
    relation S(depot_id: i32, item_id: i32);
    relation N(job_id: i32, item_id: i32);
    r0 = rename D { driver_id -> driver, depot_id -> depot };
    r1 = rename S { depot_id -> depot, item_id -> item };
    r2 = natural_join r0 with r1;
    r3 = rename N { job_id -> job, item_id -> item };
    r4 = natural_join r2 with r3;
    r5 = project r4 keep { driver, job };
    output r5 as answer(driver, job);
}
