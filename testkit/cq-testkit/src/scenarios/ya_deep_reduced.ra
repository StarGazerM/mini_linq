relational {
    relation R(first: i32, second: i32);
    relation S(first: i32, second: i32);
    relation T(first: i32, second: i32);
    relation U(first: i32, second: i32);
    r0 = rename S@1 { first -> b, second -> c };
    r1 = rename R@0 { first -> a, second -> b };
    r2 = semijoin r0 with r1;
    r3 = rename T@2 { first -> c, second -> d };
    r4 = semijoin r3 with r2;
    r5 = rename U@3 { first -> d, second -> e };
    r6 = semijoin r5 with r4;
    r7 = semijoin r4 with r6;
    r8 = semijoin r2 with r7;
    r9 = semijoin r1 with r8;
    r10 = natural_join r9 with r8;
    r11 = natural_join r10 with r7;
    r12 = natural_join r11 with r6;
    r13 = project r12 keep { a, e };
    output r13 as answer(a, e);
}
