relational {
    relation R(first: i32, second: i32, value: i32);
    relation S(first: i32, second: i32, third: i32);
    relation T(first: i32, second: i32, value: i32);
    r0 = rename S@1 { first -> a, second -> b, third -> c };
    r1 = rename R@0 { first -> a, second -> b, value -> u };
    r2 = semijoin r0 with r1;
    r3 = rename T@2 { first -> b, second -> c, value -> v };
    r4 = semijoin r3 with r2;
    r5 = semijoin r2 with r4;
    r6 = semijoin r1 with r5;
    r7 = natural_join r6 with r5;
    r8 = natural_join r7 with r4;
    r9 = project r8 keep { u, v };
    output r9 as answer(u, v);
}
