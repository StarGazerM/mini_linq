relational { relation R (a : i32 , b : i32) ; relation S (b : i32 , c : i32) ; relation T (c : i32 , d : i32) ; r0 = rename R @ 0 { a - > a , b - > b } ; r1 = rename S @ 1.0 . 0 { b - > b , c - > c } ; r2 = natural_join r0 with r1 ; r3 = rename T @ 1.0 . 1 { c - > c , d - > d } ; r4 = semijoin r2 with r3 ; r5 = natural_join r4 with r3 ; r6 = guard r5 if (keep ! (d)) scope [a , b , c , d] @ 1.0 . 2 ; r7 = project r6 keep { a , b , c , d } ; r8 = anti [a , b] r0 , r7 ; r9 = rename S @ 1.1 . 0 { b - > b , c - > c } ; r10 = natural_join r8 with r9 ; r11 = rename T @ 1.1 . 1 { c - > c , d - > d } ; r12 = select r11 if (d > 0) ; r13 = semijoin r10 with r12 ; r14 = natural_join r13 with r12 ; r15 = project r14 keep { a , b , c , d } ; r16 = union r7 , r15 block @ 1 free [a , b] interface [c , d] fallback over r0 ; r17 = project r16 keep { a , c } ; output r17 as answer (a , c) ; }
