relational { relation Lineitem (l_orderkey : i64 , l_partkey : i64 , l_suppkey : i64) ; relation PartSupp (ps_partkey : i64 , ps_suppkey : i64) ; relation Part (p_partkey : i64 , p_name : String) ; relation Supplier (s_suppkey : i64 , s_nationkey : i32) ; relation Orders (o_orderkey : i64) ; relation Nation (n_nationkey : i32) ; r0 = rename PartSupp @ 2 { ps_partkey - > part_key , ps_suppkey - > supplier_key } ; r1 = rename Part @ 3 { p_partkey - > part_key , p_name - > part_name } ; r2 = select r1 if (# [total] { part_name = part_name } (part_name . contains ("green"))) ; r3 = semijoin r0 with r2 ; r4 = rename Lineitem @ 1 { l_orderkey - > order_key , l_partkey - > part_key , l_suppkey - > supplier_key } ; r5 = semijoin r4 with r3 ; r6 = rename Orders @ 0 { o_orderkey - > order_key } ; r7 = semijoin r6 with r5 ; r8 = natural_join r7 with r5 ; r11 = rename Supplier @ 5 { s_suppkey - > supplier_key , s_nationkey - > nation_key } ; r12 = semijoin r8 with r11 ; r14 = natural_join r12 with r11 ; r15 = rename Nation @ 6 { n_nationkey - > nation_key } ; r16 = natural_join r14 with r15 ; r19 = project r16 keep { order_key , part_key , supplier_key } ; output r19 as answer (order_key , part_key , supplier_key) ; }
