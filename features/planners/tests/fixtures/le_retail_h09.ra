relational { relation Lineitem (l_orderkey : i64 , l_partkey : i64 , l_suppkey : i64) ; relation PartSupp (ps_partkey : i64 , ps_suppkey : i64) ; relation Part (p_partkey : i64 , p_name : String) ; relation Supplier (s_suppkey : i64 , s_nationkey : i32) ; relation Orders (o_orderkey : i64) ; relation Nation (n_nationkey : i32) ; r0 = rename Orders @ 0 { o_orderkey - > order_key } ; r1 = rename Lineitem @ 1 { l_orderkey - > order_key , l_partkey - > part_key , l_suppkey - > supplier_key } ; r2 = semijoin r0 with r1 ; r3 = natural_join r2 with r1 ; r4 = rename Part @ 3 { p_partkey - > part_key , p_name - > part_name } ; r5 = semijoin r3 with r4 ; r6 = rename PartSupp @ 2 { ps_partkey - > part_key , ps_suppkey - > supplier_key } ; r7 = natural_join r5 with r6 ; r8 = rename Supplier @ 5 { s_suppkey - > supplier_key , s_nationkey - > nation_key } ; r9 = semijoin r7 with r8 ; r10 = natural_join r9 with r4 ; r11 = natural_join r10 with r6 ; r12 = guard r11 if (part_name . contains ("green")) ; r13 = natural_join r12 with r8 ; r14 = rename Nation @ 6 { n_nationkey - > nation_key } ; r15 = natural_join r13 with r14 ; r16 = natural_join r15 with r14 ; r17 = project r16 keep { order_key , part_key , supplier_key } ; output r17 as answer (order_key , part_key , supplier_key) ; }
