struct D72;
relation Lineitem(l_orderkey:i64,l_partkey:i64,l_suppkey:i64,l_shipdate:Date,l_quantity:Decimal);
relation Orders(o_orderkey:i64,o_custkey:i64);
relation PartSupp(ps_partkey:i64,ps_suppkey:i64,ps_availqty:i64);
relation Supplier(s_suppkey:i64,s_nationkey:i32);
relation Part(p_partkey:i64);
relation Customer(c_custkey:i64,c_nationkey:i32);
relation Nation(n_nationkey:i32);
answer(order_key,part_key,supplier_key,nation_key) :-
Orders(order_key,customer_key), Lineitem(order_key,part_key,supplier_key,ship_date,quantity),
if *ship_date >= start && *ship_date < end, if *quantity > minimum,
PartSupp(part_key,supplier_key,available), if *available > 0,
Supplier(supplier_key,nation_key), Part(part_key), Customer(customer_key,nation_key), Nation(nation_key);
