relational { relation Customer (c_custkey : i64 [0] , c_nationkey : i32 [1]) ; relation Orders (o_orderkey : i64 [0] , o_custkey : i64 [0] , o_orderdate : Date [2]) ; relation Lineitem (l_orderkey : i64 [0] , l_suppkey : i64 [0]) ; relation Supplier (s_suppkey : i64 [0] , s_nationkey : i32 [1]) ; relation Nation (n_nationkey : i32 [1] , n_regionkey : i32 [1]) ; relation Region (r_regionkey : i32 [1] , r_name : StringCode [3]) ; r0 = rename Nation @ 5 { n_nationkey - > nation_key , n_regionkey - > region_key } ; r1 = rename Region @ 6 { r_regionkey - > region_key } constants { r_name = "ASIA" } ; r2 = semijoin r0 with r1 ; r3 = rename Customer @ 4 { c_custkey - > customer_key , c_nationkey - > nation_key } ; r4 = semijoin r3 with r2 ; r5 = rename Orders @ 1 { o_orderkey - > order_key , o_custkey - > customer_key , o_orderdate - > order_date } ; r6 = select r5 if (order_date >= @ (start) , order_date < @ (end)) ; r7 = semijoin r6 with r4 ; r8 = rename Lineitem @ 0 { l_orderkey - > order_key , l_suppkey - > supplier_key } ; r9 = semijoin r8 with r7 ; r10 = rename Supplier @ 7 { s_suppkey - > supplier_key , s_nationkey - > nation_key } ; r11 = semijoin r9 with r10 ; r12 = natural_join r11 with r7 ; r14 = natural_join r12 with r4 ; r16 = natural_join r14 with r10 ; r20 = project r16 keep { nation_key , order_key , supplier_key } ; output r20 as answer (order_key , supplier_key , nation_key) ; }
