relational { relation Customer (c_custkey : i64 , c_nationkey : i32) ; relation Orders (o_orderkey : i64 , o_custkey : i64 , o_orderdate : Date) ; relation Lineitem (l_orderkey : i64 , l_suppkey : i64) ; relation Supplier (s_suppkey : i64 , s_nationkey : i32) ; relation Nation (n_nationkey : i32 , n_regionkey : i32) ; relation Region (r_regionkey : i32 , r_name : String) ; r0 = rename Nation @ 5 { n_nationkey - > nation_key , n_regionkey - > region_key } ; r1 = rename Region @ 6 { r_regionkey - > region_key , r_name - > __cq_6_1 } ; r2 = select r1 if (__cq_6_1 = "ASIA") ; r3 = semijoin r0 with r2 ; r4 = rename Customer @ 4 { c_custkey - > customer_key , c_nationkey - > nation_key } ; r5 = semijoin r4 with r3 ; r6 = rename Orders @ 1 { o_orderkey - > order_key , o_custkey - > customer_key , o_orderdate - > order_date } ; r7 = select r6 if (order_date >= @ start , order_date < @ end) ; r8 = semijoin r7 with r5 ; r9 = rename Lineitem @ 0 { l_orderkey - > order_key , l_suppkey - > supplier_key } ; r10 = semijoin r9 with r8 ; r11 = rename Supplier @ 8 { s_suppkey - > supplier_key , s_nationkey - > nation_key } ; r12 = semijoin r10 with r11 ; r13 = natural_join r12 with r8 ; r15 = natural_join r13 with r5 ; r20 = natural_join r15 with r11 ; r21 = project r20 keep { nation_key , order_key , supplier_key } ; output r21 as answer (order_key , supplier_key , nation_key) ; }
