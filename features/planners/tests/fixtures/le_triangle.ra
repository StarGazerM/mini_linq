relational { relation R (first : i32 , second : i32) ; relation S (first : i32 , second : i32) ; relation T (first : i32 , second : i32) ; r0 = rename R @ 0 { first - > a , second - > b } ; r1 = rename S @ 1 { first - > b , second - > c } ; r2 = semijoin r0 with r1 ; r3 = rename T @ 2 { first - > c , second - > a } ; r4 = semijoin r2 with r3 ; r5 = natural_join r4 with r1 ; r6 = natural_join r5 with r3 ; r7 = project r6 keep { a , b , c } ; output r7 as answer (a , b , c) ; }
