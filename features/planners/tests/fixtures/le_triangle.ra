relational { relation R (first : i32 [0] , second : i32 [0]) ; relation S (first : i32 [0] , second : i32 [0]) ; relation T (first : i32 [0] , second : i32 [0]) ; r0 = rename R { first - > a , second - > b } ; r1 = rename S { first - > b , second - > c } ; r2 = semijoin r0 with r1 ; r3 = rename T { first - > c , second - > a } ; r4 = semijoin r2 with r3 ; r5 = natural_join r4 with r1 ; r6 = natural_join r5 with r3 ; r7 = project r6 keep { a , b , c } ; output r7 as answer (a , b , c) ; }
