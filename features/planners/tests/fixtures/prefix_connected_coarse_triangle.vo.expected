// prefix_connected_coarse_triangle.vo.expected: expected VO derived by hand from doc/formal (ir_vo.tex WF-VO-*,
// passes.tex I1-I5 and the planner O-/S-/R- rules), independently of the producer.
// Every step is preceded by the rule that fixes its position; RULE GAP marks a position the rules leave open,
// with the tie-break used.
// Planner prefix connected,coarse = O_{Prefix(Connected),Coarse}.
// c0=R(a,b), c1=S(b,c), c2=T(c,a)
// S-Connected rank (a_i,1,[s_i=0],0,i); no reductions (planner facade: Reductions::None for prefix planners).
struct Triangle ; relation R (first : i32 [0] , second : i32 [0]) ; relation S (first : i32 [0] , second : i32 [0]) ; relation T (first : i32 [0] , second : i32 [0]) ; answer (a , b , c) : - R (a , b) , S (b , c) , T (c , a) ;
valuation {
    // B={}: all three atoms rank equal on (a,1,1,0) -> written position (I4 last): c0
    R @ 0 (a , b) ;
    // B={a,b}: c1 and c2 both connected -> tie broken by written position: c1
    S @ 1 (b , c) ;
    // a_i=0: filter ranks first; only remaining clause
    T @ 2 (c , a) ;
}
