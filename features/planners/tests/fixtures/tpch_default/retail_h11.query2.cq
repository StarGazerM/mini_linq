struct Total ; relation Stock (part_key : i64 , supplier_key : i64 , quantity : i64 , cost_units : i64) ; relation answer (value : i64) ; answer (sum (value)) :- Stock (part_key , supplier_key , quantity , cost_units) , let value : i64 = * quantity * * cost_units ;
