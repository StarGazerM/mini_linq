// retail_h22.query0.vo.expected: expected default-route VO of TPC-H kernel retail_h22 (query0_main), derived
// from doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: O-EvidenceLe premise fails: no count for ['QualifyingPhones'] -> O_Prefix(Connected),Coarse
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself and nothing is drained: no `check`/`after` markers.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Query ; relation Customer (c_custkey : i64 [0] , c_phone : StringCode [1]) ; relation Orders (o_orderkey : i64 [0] , o_custkey : i64 [0]) ; relation QualifyingPhones (phone : StringCode [1]) ; relation answer (custkey : i64 [0]) ; answer (custkey) : - Customer (custkey , phone) , QualifyingPhones (phone) , ! Orders (_ , custkey) ;
valuation evidence from "TPC-H dbgen SF1 row counts (DuckDB tpch dbgen(sf=1), equal to the GPU SF1 manifest); TPC-H primary keys" { count Customer = 150000 ; key Customer [c_custkey] ; count Orders = 1500000 ; key Orders [o_orderkey] ; } {
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@1'] broken by written position (I4 last)
    Customer @ 0 (custkey , phone) ;
    // I2/a_i=0: ready filter, placed at first ready boundary
    ! Orders (_ , custkey) ;
    // I2/a_i=0: ready filter, placed at first ready boundary
    QualifyingPhones @ 1 (phone) ;
}
