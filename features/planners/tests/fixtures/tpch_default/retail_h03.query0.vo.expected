// retail_h03.query0.vo.expected: expected default-route VO of TPC-H kernel retail_h03 (query0_main), derived
// from doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: O-EvidenceLe: no dominating functional root (w=Lineitem@0; F=[]) ->
// O_Prefix(Connected),Coarse
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself at their first ready boundary; membership follows from the bound prefix.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Query ; relation Customer (c_custkey : i64 [0] , c_mktsegment : cq_load :: StringCode [1] in [0] (dictionaries . domain ("c_mktsegment"))) ; relation Orders (o_orderkey : i64 [0] , o_custkey : i64 [0] , o_orderdate : Date [2]) ; relation Lineitem (l_orderkey : i64 [0] , l_shipdate : Date [2]) ; relation answer (order_key : i64 [0] , customer_key : i64 [0]) ; answer (order_key , customer_key) : - Lineitem (order_key , ship_date) , where ship_date > (cutoff) , Orders (order_key , customer_key , order_date) , where order_date < (cutoff) , Customer (customer_key , __cq_4_1) , where __cq_4_1 == (__cq_c_0) capture { domain __cq_c_0 : cq_load :: StringCode in [0] (dictionaries . domain ("c_mktsegment")) = exact ("BUILDING") ; } ;
valuation evidence from "TPC-H dbgen SF1 row counts (DuckDB tpch dbgen(sf=1), equal to the GPU SF1 manifest); TPC-H primary keys" { count Customer = 150000 ; key Customer [c_custkey] ; count Orders = 1500000 ; key Orders [o_orderkey] ; count Lineitem = 6001215 ; } {
    // O-Restrict/H-Local: restriction of clause 1 on Lineitem@0 heads the scope (H-Local order)
    restrict Lineitem @ 0 where ship_date > @ (cutoff) ;
    // O-Restrict/H-Local: restriction of clause 3 on Orders@2 heads the scope (H-Local order)
    restrict Orders @ 2 where order_date < @ (cutoff) ;
    // O-Restrict/H-Local: restriction of clause 5 on Customer@4 heads the scope (H-Local order)
    restrict Customer @ 4 where __cq_4_1 = @ (__cq_c_0) ;
    // R-Masks: Customer@4 is child of Orders@2 in H-SpanningCore tree (GYO join tree) rooted at outer Lineitem@0;
    // child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Orders @ 2 with Customer @ 4 (customer_key , _) ;
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@2', '@4'] broken by written position (I4 last)
    Lineitem @ 0 (order_key , ship_date) ;
    // S-Connected: connected (shares ['order_key'])
    Orders @ 2 (order_key , customer_key , order_date) ;
    // S-Connected: connected (shares ['customer_key'])
    Customer @ 4 (customer_key , __cq_4_1) ;
}
