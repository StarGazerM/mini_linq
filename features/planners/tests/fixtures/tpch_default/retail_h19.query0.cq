struct Query ; relation Lineitem (l_orderkey : i64 , l_linenumber : i64 , l_partkey : i64 , l_quantity : Decimal , l_extendedprice : Decimal , l_discount : Decimal , l_shipmode : StringCode in (data . dictionaries . domain ("l_shipmode")) , l_shipinstruct : StringCode in (data . dictionaries . domain ("l_shipinstruct"))) ; relation Part (p_partkey : i64 , p_brand : StringCode in (data . dictionaries . domain ("p_brand")) , p_container : StringCode in (data . dictionaries . domain ("p_container")) , p_size : i32) ; relation answer (revenue : i64) ; answer (sum (revenue_units)) :- Lineitem (order_key , line_number , part_key , quantity , price , discount , ship_mode , ship_instruction) , where (ship_mode == "AIR" || ship_mode == "AIR REG") && ship_instruction == "DELIVER IN PERSON" , Part (part_key , brand , container , size) , where (brand == "Brand#12" && (container == "SM CASE" || container == "SM BOX" || container == "SM PACK" || container == "SM PKG") && quantity >= q1_low && quantity <= q1_high && size >= 1 && size <= 5) || (brand == "Brand#23" && (container == "MED BAG" || container == "MED BOX" || container == "MED PKG" || container == "MED PACK") && quantity >= q2_low && quantity <= q2_high && size >= 1 && size <= 10) || (brand == "Brand#34" && (container == "LG CASE" || container == "LG BOX" || container == "LG PACK" || container == "LG PKG") && quantity >= q3_low && quantity <= q3_high && size >= 1 && size <= 15) , let revenue_units : i64 = price . scaled () * (100 - discount . scaled ()) ;
