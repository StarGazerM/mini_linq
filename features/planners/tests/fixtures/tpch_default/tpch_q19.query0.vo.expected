// tpch_q19.query0.vo.expected: expected default-route VO of TPC-H kernel tpch_q19 (query0_main), derived from
// doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: no evidence recorded
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself at their first ready boundary; membership follows from the bound prefix.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Query19 ; relation lineitem (partkey : i64 [0] , orderkey : i64 [0] , linenumber : i64 [0] , quantity : Decimal [1] , price : Decimal [1] , discount : Decimal [1] , shipmode : StringCode [2] in [0] (data . dictionaries . domain ("l_shipmode")) , shipinstruct : StringCode [2] in [1] (data . dictionaries . domain ("l_shipinstruct"))) ; relation part (partkey : i64 [0] , brand : StringCode [2] in [2] (data . dictionaries . domain ("p_brand")) , container : StringCode [2] in [3] (data . dictionaries . domain ("p_container")) , size : i32 [3]) ; rows (group , orderkey , linenumber , amount) : - lineitem (partkey , orderkey , linenumber , quantity , price , discount , shipmode , shipinstruct) , part (partkey , brand , container , size) , where (((shipmode == (__cq_c_0))) || ((shipmode == (__cq_c_1)))) , where shipinstruct == (__cq_c_2) , where (((brand == (__cq_c_3)) && ((((container == (__cq_c_4))) || ((container == (__cq_c_5))) || ((container == (__cq_c_6))) || ((container == (__cq_c_7))))) && (quantity in (q1_low) ..= (q1_high)) && (size in 1 ..= 5)) || ((brand == (__cq_c_8)) && ((((container == (__cq_c_9))) || ((container == (__cq_c_10))) || ((container == (__cq_c_11))) || ((container == (__cq_c_12))))) && (quantity in (q2_low) ..= (q2_high)) && (size in 1 ..= 10)) || ((brand == (__cq_c_13)) && ((((container == (__cq_c_14))) || ((container == (__cq_c_15))) || ((container == (__cq_c_16))) || ((container == (__cq_c_17))))) && (quantity in (q3_low) ..= (q3_high)) && (size in 1 ..= 15))) , let amount : i128 = i128 :: from (price . scaled ()) * (100 - i128 :: from (discount . scaled ())) capture { let group : i32 = 0 ; domain __cq_c_0 : StringCode in [0] (data . dictionaries . domain ("l_shipmode")) = exact ("AIR") ; domain __cq_c_1 : StringCode in [0] (data . dictionaries . domain ("l_shipmode")) = exact ("AIR REG") ; domain __cq_c_2 : StringCode in [1] (data . dictionaries . domain ("l_shipinstruct")) = exact ("DELIVER IN PERSON") ; domain __cq_c_3 : StringCode in [2] (data . dictionaries . domain ("p_brand")) = exact ("Brand#12") ; domain __cq_c_4 : StringCode in [3] (data . dictionaries . domain ("p_container")) = exact ("SM CASE") ; domain __cq_c_5 : StringCode in [3] (data . dictionaries . domain ("p_container")) = exact ("SM BOX") ; domain __cq_c_6 : StringCode in [3] (data . dictionaries . domain ("p_container")) = exact ("SM PACK") ; domain __cq_c_7 : StringCode in [3] (data . dictionaries . domain ("p_container")) = exact ("SM PKG") ; domain __cq_c_8 : StringCode in [2] (data . dictionaries . domain ("p_brand")) = exact ("Brand#23") ; domain __cq_c_9 : StringCode in [3] (data . dictionaries . domain ("p_container")) = exact ("MED BAG") ; domain __cq_c_10 : StringCode in [3] (data . dictionaries . domain ("p_container")) = exact ("MED BOX") ; domain __cq_c_11 : StringCode in [3] (data . dictionaries . domain ("p_container")) = exact ("MED PKG") ; domain __cq_c_12 : StringCode in [3] (data . dictionaries . domain ("p_container")) = exact ("MED PACK") ; domain __cq_c_13 : StringCode in [2] (data . dictionaries . domain ("p_brand")) = exact ("Brand#34") ; domain __cq_c_14 : StringCode in [3] (data . dictionaries . domain ("p_container")) = exact ("LG CASE") ; domain __cq_c_15 : StringCode in [3] (data . dictionaries . domain ("p_container")) = exact ("LG BOX") ; domain __cq_c_16 : StringCode in [3] (data . dictionaries . domain ("p_container")) = exact ("LG PACK") ; domain __cq_c_17 : StringCode in [3] (data . dictionaries . domain ("p_container")) = exact ("LG PKG") ; } ;
valuation {
    // O-Restrict/H-Local: restriction of clause 2 on lineitem@0 heads the scope (H-Local order)
    restrict lineitem @ 0 where (shipmode = @ (__cq_c_0)) or (shipmode = @ (__cq_c_1)) ;
    // O-Restrict/H-Local: restriction of clause 3 on lineitem@0 heads the scope (H-Local order)
    restrict lineitem @ 0 where shipinstruct = @ (__cq_c_2) ;
    // O-Restrict/H-Local: restriction of E-Domain D_brand of clause 4 on part@1 heads the scope (H-Local order;
    // O-DomainOrder sorts D_x by variable name)
    restrict part @ 1 where (brand = @ (__cq_c_3)) or (brand = @ (__cq_c_8)) or (brand = @ (__cq_c_13)) ;
    // E-Domain admits atomic conjuncts only: the nested container disjunction
    // contributes no domain restriction; the full row predicate below retains it.
    // O-Restrict/H-Local: restriction of E-Domain D_quantity of clause 4 on lineitem@0 heads the scope (H-Local
    // order; O-DomainOrder sorts D_x by variable name)
    restrict lineitem @ 0 where (quantity between @ (q1_low) and @ (q1_high)) or (quantity between @ (q2_low) and @ (q2_high)) or (quantity between @ (q3_low) and @ (q3_high)) ;
    // O-Restrict/H-Local: restriction of E-Domain D_size of clause 4 on part@1 heads the scope (H-Local order; order
    // O-DomainOrder sorts D_x by variable name)
    restrict part @ 1 where (size between 1 and 5) or (size between 1 and 10) or (size between 1 and 15) ;
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@1'] broken by written position (I4 last)
    lineitem @ 0 (partkey , orderkey , linenumber , quantity , price , discount , shipmode , shipinstruct) ;
    // rank (a,0,..): ready introducing nonatom precedes introducing atoms
    let amount : i128 = i128 :: from (price . scaled ()) * (100 - i128 :: from (discount . scaled ())) ;
    // S-Connected: connected (shares ['partkey'])
    part @ 1 (partkey , brand , container , size) ;
    // I2/a_i=0: ready filter, placed at first ready boundary
    where (brand = @ (__cq_c_3) and (container = @ (__cq_c_4)) or (container = @ (__cq_c_5)) or (container = @ (__cq_c_6)) or (container = @ (__cq_c_7)) and quantity between @ (q1_low) and @ (q1_high) and size between 1 and 5) or (brand = @ (__cq_c_8) and (container = @ (__cq_c_9)) or (container = @ (__cq_c_10)) or (container = @ (__cq_c_11)) or (container = @ (__cq_c_12)) and quantity between @ (q2_low) and @ (q2_high) and size between 1 and 10) or (brand = @ (__cq_c_13) and (container = @ (__cq_c_14)) or (container = @ (__cq_c_15)) or (container = @ (__cq_c_16)) or (container = @ (__cq_c_17)) and quantity between @ (q3_low) and @ (q3_high) and size between 1 and 15) ;
}
