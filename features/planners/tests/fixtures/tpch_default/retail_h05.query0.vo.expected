// retail_h05.query0.vo.expected: expected default-route VO of TPC-H kernel retail_h05 (query0_main), derived
// from doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: O-EvidenceLe: no dominating functional root (w=Lineitem@0; F=[]) ->
// O_Prefix(Connected),Coarse
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself at their first ready boundary; membership follows from the bound prefix.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Query ; relation Customer (c_custkey : i64 [0] , c_nationkey : i32 [1]) ; relation Orders (o_orderkey : i64 [0] , o_custkey : i64 [0] , o_orderdate : Date [2]) ; relation Lineitem (l_orderkey : i64 [0] , l_suppkey : i64 [0]) ; relation Supplier (s_suppkey : i64 [0] , s_nationkey : i32 [1]) ; relation Nation (n_nationkey : i32 [1] , n_regionkey : i32 [1]) ; relation Region (r_regionkey : i32 [1] , r_name : cq_load :: StringCode [3] in [0] (dictionaries . domain ("r_name"))) ; relation answer (order_key : i64 [0] , supplier_key : i64 [0] , nation_key : i32 [1]) ; answer (order_key , supplier_key , nation_key) : - Lineitem (order_key , supplier_key) , Orders (order_key , customer_key , order_date) , where order_date >= (start) , where order_date < (end) , Customer (customer_key , nation_key) , Nation (nation_key , region_key) , Region (region_key , __cq_6_1) , where __cq_6_1 == (__cq_c_0) , Supplier (supplier_key , nation_key) capture { domain __cq_c_0 : cq_load :: StringCode in [0] (dictionaries . domain ("r_name")) = exact ("ASIA") ; } ;
valuation {
    // O-Restrict/H-Local: restriction of clause 2 on Orders@1 heads the scope (H-Local order)
    restrict Orders @ 1 where order_date >= @ (start) ;
    // O-Restrict/H-Local: restriction of clause 3 on Orders@1 heads the scope (H-Local order)
    restrict Orders @ 1 where order_date < @ (end) ;
    // O-Restrict/H-Local: restriction of clause 7 on Region@6 heads the scope (H-Local order)
    restrict Region @ 6 where __cq_6_1 = @ (__cq_c_0) ;
    // R-Masks: Region@6 is child of Nation@5 in H-SpanningCore tree (GYO ears + spanning core) rooted at outer
    // Lineitem@0; child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Nation @ 5 with Region @ 6 (region_key , _) ;
    // R-Masks: Nation@5 is child of Customer@4 in H-SpanningCore tree (GYO ears + spanning core) rooted at outer
    // Lineitem@0; child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Customer @ 4 with Nation @ 5 (nation_key , _) ;
    // R-Masks: Customer@4 is child of Orders@1 in H-SpanningCore tree (GYO ears + spanning core) rooted at outer
    // Lineitem@0; child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Orders @ 1 with Customer @ 4 (customer_key , _) ;
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@1', '@4', '@5', '@6', '@8'] broken by written
    // position (I4 last)
    Lineitem @ 0 (order_key , supplier_key) ;
    // S-Connected: connected (shares ['order_key']); tie with ['@8'] broken by written position (I4 last)
    Orders @ 1 (order_key , customer_key , order_date) ;
    // S-Connected: connected (shares ['customer_key']); tie with ['@8'] broken by written position (I4 last)
    Customer @ 4 (customer_key , nation_key) ;
    // I2/a_i=0: ready filter, placed at first ready boundary
    Supplier @ 8 (supplier_key , nation_key) ;
    // S-Connected: connected (shares ['nation_key'])
    Nation @ 5 (nation_key , region_key) ;
    // S-Connected: connected (shares ['region_key'])
    Region @ 6 (region_key , __cq_6_1) ;
}
