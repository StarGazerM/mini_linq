// retail_d72_inner.query0.vo.expected: expected default-route VO of TPC-H kernel retail_d72_inner (query0_main),
// derived from doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: O-EvidenceLe: no dominating functional root (w=Orders@0; F=[]) ->
// O_Prefix(Connected),Coarse
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself and nothing is drained: no `check`/`after` markers.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Query ; relation Lineitem (l_orderkey : i64 [0] , l_partkey : i64 [0] , l_suppkey : i64 [0] , l_shipdate : Date [1] , l_quantity : Decimal [2]) ; relation Orders (o_orderkey : i64 [0] , o_custkey : i64 [0]) ; relation PartSupp (ps_partkey : i64 [0] , ps_suppkey : i64 [0] , ps_availqty : i64 [0]) ; relation Supplier (s_suppkey : i64 [0] , s_nationkey : i32 [3]) ; relation Part (p_partkey : i64 [0]) ; relation Customer (c_custkey : i64 [0] , c_nationkey : i32 [3]) ; relation Nation (n_nationkey : i32 [3]) ; answer (order_key , part_key , supplier_key , nation_key) : - Orders (order_key , customer_key) , Lineitem (order_key , part_key , supplier_key , ship_date , quantity) , where ship_date >= (start) , where ship_date < (end) , where quantity > (minimum) , PartSupp (part_key , supplier_key , available) , where available > 0 , Supplier (supplier_key , nation_key) , Part (part_key) , Customer (customer_key , nation_key) , Nation (nation_key) ;
valuation evidence from "TPC-H dbgen SF1 row counts (DuckDB tpch dbgen(sf=1), equal to the GPU SF1 manifest); TPC-H primary keys" { count Lineitem = 6001215 ; count Orders = 1500000 ; key Orders [o_orderkey] ; count PartSupp = 800000 ; key PartSupp [ps_partkey , ps_suppkey] ; count Supplier = 10000 ; key Supplier [s_suppkey] ; count Part = 200000 ; key Part [p_partkey] ; count Customer = 150000 ; key Customer [c_custkey] ; count Nation = 25 ; key Nation [n_nationkey] ; } {
    // O-Restrict/H-Local: restriction of clause 2 on Lineitem@1 heads the scope (H-Local order)
    restrict Lineitem @ 1 where ship_date >= @ (start) ;
    // O-Restrict/H-Local: restriction of clause 3 on Lineitem@1 heads the scope (H-Local order)
    restrict Lineitem @ 1 where ship_date < @ (end) ;
    // O-Restrict/H-Local: restriction of clause 4 on Lineitem@1 heads the scope (H-Local order)
    restrict Lineitem @ 1 where quantity > @ (minimum) ;
    // O-Restrict/H-Local: restriction of clause 6 on PartSupp@5 heads the scope (H-Local order)
    restrict PartSupp @ 5 where available > 0 ;
    // R-Masks: PartSupp@5 is child of Lineitem@1 in H-SpanningCore tree (GYO ears + spanning core) rooted at outer
    // Orders@0; child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Lineitem @ 1 with PartSupp @ 5 (part_key , supplier_key , _) ;
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@1', '@5', '@7', '@8', '@9', '@10'] broken by
    // written position (I4 last)
    Orders @ 0 (order_key , customer_key) ;
    // S-Connected: connected (shares ['order_key']); tie with ['@9'] broken by written position (I4 last)
    Lineitem @ 1 (order_key , part_key , supplier_key , ship_date , quantity) ;
    // I2/a_i=0: ready filter, placed at first ready boundary. DIFFERS: producer prints `check after [5 , 7]`
    // (I2-drainage provenance of its pre-drain rank, which lacks a_i)
    Part @ 8 (part_key) ;
    // S-Connected: connected (shares ['part_key', 'supplier_key']); tie with ['@7', '@9'] broken by written position
    // (I4 last)
    PartSupp @ 5 (part_key , supplier_key , available) ;
    // S-Connected: connected (shares ['supplier_key']); tie with ['@9'] broken by written position (I4 last)
    Supplier @ 7 (supplier_key , nation_key) ;
    // I2/a_i=0: ready filter, placed at first ready boundary. DIFFERS: producer prints `check` (I2-drainage
    // provenance of its pre-drain rank, which lacks a_i)
    Customer @ 9 (customer_key , nation_key) ;
    // I2/a_i=0: ready filter, placed at first ready boundary
    Nation @ 10 (nation_key) ;
}
