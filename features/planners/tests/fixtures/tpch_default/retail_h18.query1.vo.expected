// retail_h18.query1.vo.expected: expected default-route VO of TPC-H kernel retail_h18 (query1_main), derived
// from doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: O-EvidenceLe premise fails: no count for ['Quantity'] -> O_Prefix(Connected),Coarse
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself at their first ready boundary; membership follows from the bound prefix.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Query ; relation Quantity (order_key : i64 [0] , sum_quantity : i64 [0]) ; relation Orders (o_orderkey : i64 [0] , o_custkey : i64 [0] , o_orderdate : Date [1] , o_totalprice : Decimal [2]) ; relation Customer (c_custkey : i64 [0] , c_name : StringCode [3]) ; relation answer (customer_name : StringCode [3] , customer_key : i64 [0] , order_key : i64 [0] , order_date : Date [1] , total_price : i64 [0] , sum_quantity : i64 [0]) ; answer (customer_name , customer_key , order_key , order_date , price_units , sum_quantity) : - Quantity (order_key , sum_quantity) , where sum_quantity > 30000 , Orders (order_key , customer_key , order_date , total_price) , Customer (customer_key , customer_name) , let price_units : i64 = total_price . scaled () ;
valuation evidence from "TPC-H dbgen SF1 row counts (DuckDB tpch dbgen(sf=1), equal to the GPU SF1 manifest); TPC-H primary keys" { count Orders = 1500000 ; key Orders [o_orderkey] ; count Customer = 150000 ; key Customer [c_custkey] ; } {
    // O-Restrict/H-Local: restriction of clause 1 on Quantity@0 heads the scope (H-Local order)
    restrict Quantity @ 0 where sum_quantity > 30000 ;
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@2', '@3'] broken by written position (I4 last)
    Quantity @ 0 (order_key , sum_quantity) ;
    // S-Connected: connected (shares ['order_key'])
    Orders @ 2 (order_key , customer_key , order_date , total_price) ;
    // rank (a,0,..): ready introducing nonatom precedes introducing atoms
    let price_units : i64 = total_price . scaled () ;
    // S-Connected: connected (shares ['customer_key'])
    Customer @ 3 (customer_key , customer_name) ;
}
