// retail_h12.query0.vo.expected: expected default-route VO of TPC-H kernel retail_h12 (query0_main), derived
// from doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: O-EvidenceLe: no dominating functional root (w=Lineitem@0; F=[]) ->
// O_Prefix(Connected),Coarse
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself at their first ready boundary; membership follows from the bound prefix.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Matches ; relation Orders (o_orderkey : i64 [0] , o_orderpriority : StringCode [1]) ; relation Lineitem (l_orderkey : i64 [0] , l_linenumber : i64 [0] , l_shipmode : StringCode [1] in [0] (data . dictionaries . domain ("l_shipmode")) , l_commitdate : Date [2] , l_receiptdate : Date [2] , l_shipdate : Date [2]) ; relation answer (order_key : i64 [0] , line_number : i64 [0] , shipmode : StringCode [1] , commitdate : Date [2] , receiptdate : Date [2] , shipdate : Date [2] , priority : StringCode [1]) ; answer (order_key , line_number , shipmode , commitdate , receiptdate , shipdate , priority) : - Lineitem (order_key , line_number , shipmode , commitdate , receiptdate , shipdate) , where (((shipmode == (__cq_c_0))) || ((shipmode == (__cq_c_1)))) , where shipdate < commitdate , where commitdate < receiptdate , where receiptdate >= (start) , where receiptdate < (end) , Orders (order_key , priority) capture { domain __cq_c_0 : StringCode in [0] (data . dictionaries . domain ("l_shipmode")) = exact ("MAIL") ; domain __cq_c_1 : StringCode in [0] (data . dictionaries . domain ("l_shipmode")) = exact ("SHIP") ; } ;
valuation evidence from "TPC-H dbgen SF1 row counts (DuckDB tpch dbgen(sf=1), equal to the GPU SF1 manifest); TPC-H primary keys" { count Orders = 1500000 ; key Orders [o_orderkey] ; count Lineitem = 6001215 ; key Lineitem [l_orderkey , l_linenumber] ; } {
    // O-Restrict/H-Local: restriction of clause 1 on Lineitem@0 heads the scope (H-Local order)
    restrict Lineitem @ 0 where (shipmode = @ (__cq_c_0)) or (shipmode = @ (__cq_c_1)) ;
    // O-Restrict/H-Local: restriction of clause 2 on Lineitem@0 heads the scope (H-Local order)
    restrict Lineitem @ 0 where shipdate < commitdate ;
    // O-Restrict/H-Local: restriction of clause 3 on Lineitem@0 heads the scope (H-Local order)
    restrict Lineitem @ 0 where commitdate < receiptdate ;
    // O-Restrict/H-Local: restriction of clause 4 on Lineitem@0 heads the scope (H-Local order)
    restrict Lineitem @ 0 where receiptdate >= @ (start) ;
    // O-Restrict/H-Local: restriction of clause 5 on Lineitem@0 heads the scope (H-Local order)
    restrict Lineitem @ 0 where receiptdate < @ (end) ;
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@6'] broken by written position (I4 last)
    Lineitem @ 0 (order_key , line_number , shipmode , commitdate , receiptdate , shipdate) ;
    // S-Connected: connected (shares ['order_key'])
    Orders @ 6 (order_key , priority) ;
}
