// retail_d27.query0.vo.expected: expected default-route VO of TPC-H kernel retail_d27 (query0_main), derived
// from doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: O-EvidenceLe: no dominating functional root (w=Lineitem@0; F=[]) ->
// O_Prefix(Connected),Coarse
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself at their first ready boundary; membership follows from the bound prefix.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Query ; relation Lineitem (l_orderkey : i64 [0] , l_partkey : i64 [0] , l_suppkey : i64 [0]) ; relation Orders (o_orderkey : i64 [0] , o_orderdate : Date [1]) ; relation Part (p_partkey : i64 [0] , p_brand : cq_load :: StringCode [2] in [0] (dictionaries . domain ("p_brand"))) ; relation Supplier (s_suppkey : i64 [0] , s_nationkey : i32 [3]) ; relation Nation (n_nationkey : i32 [3] , n_name : cq_load :: StringCode [2] in [1] (dictionaries . domain ("n_name"))) ; relation answer (order_key : i64 [0] , part_key : i64 [0] , supplier_key : i64 [0]) ; answer (order_key , part_key , supplier_key) : - Lineitem (order_key , part_key , supplier_key) , Orders (order_key , order_date) , where order_date >= (start) , where order_date < (end) , Part (part_key , __cq_4_1) , where __cq_4_1 == (__cq_c_0) , Supplier (supplier_key , nation_key) , Nation (nation_key , __cq_6_1) , where __cq_6_1 == (__cq_c_1) capture { domain __cq_c_0 : cq_load :: StringCode in [0] (dictionaries . domain ("p_brand")) = exact ("Brand#12") ; domain __cq_c_1 : cq_load :: StringCode in [1] (dictionaries . domain ("n_name")) = exact ("UNITED STATES") ; } ;
valuation {
    // O-Restrict/H-Local: restriction of clause 2 on Orders@1 heads the scope (H-Local order)
    restrict Orders @ 1 where order_date >= @ (start) ;
    // O-Restrict/H-Local: restriction of clause 3 on Orders@1 heads the scope (H-Local order)
    restrict Orders @ 1 where order_date < @ (end) ;
    // O-Restrict/H-Local: restriction of clause 5 on Part@4 heads the scope (H-Local order)
    restrict Part @ 4 where __cq_4_1 = @ (__cq_c_0) ;
    // O-Restrict/H-Local: restriction of clause 8 on Nation@7 heads the scope (H-Local order)
    restrict Nation @ 7 where __cq_6_1 = @ (__cq_c_1) ;
    // R-Masks: Nation@7 is child of Supplier@6 in H-SpanningCore tree (GYO join tree) rooted at outer Lineitem@0;
    // child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Supplier @ 6 with Nation @ 7 (nation_key , _) ;
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@1', '@4', '@6', '@7'] broken by written
    // position (I4 last)
    Lineitem @ 0 (order_key , part_key , supplier_key) ;
    // S-Connected: connected (shares ['order_key']); tie with ['@4', '@6'] broken by written position (I4 last)
    Orders @ 1 (order_key , order_date) ;
    // S-Connected: connected (shares ['part_key']); tie with ['@6'] broken by written position (I4 last)
    Part @ 4 (part_key , __cq_4_1) ;
    // S-Connected: connected (shares ['supplier_key'])
    Supplier @ 6 (supplier_key , nation_key) ;
    // S-Connected: connected (shares ['nation_key'])
    Nation @ 7 (nation_key , __cq_6_1) ;
}
