// retail_h07.query0.vo.expected: expected default-route VO of TPC-H kernel retail_h07 (query0_main), derived
// from doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: O-EvidenceLe: no dominating functional root (w=Lineitem@0; F=[]) ->
// O_Prefix(Connected),Coarse
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself at their first ready boundary; membership follows from the bound prefix.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Query ; relation Supplier (s_suppkey : i64 [0] , s_nationkey : i32 [1]) ; relation Lineitem (l_orderkey : i64 [0] , l_suppkey : i64 [0] , l_shipdate : Date [2]) ; relation Orders (o_orderkey : i64 [0] , o_custkey : i64 [0]) ; relation Customer (c_custkey : i64 [0] , c_nationkey : i32 [1]) ; relation Nation (n_nationkey : i32 [1] , n_name : cq_load :: StringCode [3] in [0] (dictionaries . domain ("n_name"))) ; relation answer (order_key : i64 [0] , supplier_nation : i32 [1] , customer_nation : i32 [1]) ; answer (order_key , supplier_nation , customer_nation) : - Lineitem (order_key , supplier_key , ship_date) , where ship_date in (start) ..= (end) , Supplier (supplier_key , supplier_nation) , Orders (order_key , customer_key) , Customer (customer_key , customer_nation) , Nation (supplier_nation , supplier_name) , Nation (customer_nation , customer_name) , where (((supplier_name == (__cq_c_0)) && (customer_name == (__cq_c_1))) || ((supplier_name == (__cq_c_2)) && (customer_name == (__cq_c_3)))) capture { domain __cq_c_0 : cq_load :: StringCode in [0] (dictionaries . domain ("n_name")) = exact ("FRANCE") ; domain __cq_c_1 : cq_load :: StringCode in [0] (dictionaries . domain ("n_name")) = exact ("GERMANY") ; domain __cq_c_2 : cq_load :: StringCode in [0] (dictionaries . domain ("n_name")) = exact ("GERMANY") ; domain __cq_c_3 : cq_load :: StringCode in [0] (dictionaries . domain ("n_name")) = exact ("FRANCE") ; } ;
valuation evidence from "TPC-H dbgen SF1 row counts (DuckDB tpch dbgen(sf=1), equal to the GPU SF1 manifest); TPC-H primary keys" { count Supplier = 10000 ; key Supplier [s_suppkey] ; count Lineitem = 6001215 ; count Orders = 1500000 ; key Orders [o_orderkey] ; count Customer = 150000 ; key Customer [c_custkey] ; count Nation = 25 ; key Nation [n_nationkey] ; } {
    // O-Restrict/H-Local: restriction of clause 1 on Lineitem@0 heads the scope (H-Local order)
    restrict Lineitem @ 0 where ship_date between @ (start) and @ (end) ;
    // O-Restrict/H-Local: restriction of E-Domain D_customer_name of clause 7 on Nation@6 heads the scope (H-Local
    // order; O-DomainOrder sorts D_x by variable name)
    restrict Nation @ 6 where (customer_name = @ (__cq_c_1)) or (customer_name = @ (__cq_c_3)) ;
    // O-Restrict/H-Local: restriction of E-Domain D_supplier_name of clause 7 on Nation@5 heads the scope (H-Local
    // order; O-DomainOrder sorts D_x by variable name)
    restrict Nation @ 5 where (supplier_name = @ (__cq_c_0)) or (supplier_name = @ (__cq_c_2)) ;
    // R-Masks: Nation@5 is child of Supplier@2 in H-SpanningCore tree (GYO join tree) rooted at outer Lineitem@0;
    // child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Supplier @ 2 with Nation @ 5 (supplier_nation , _) ;
    // R-Masks: Nation@6 is child of Customer@4 in H-SpanningCore tree (GYO join tree) rooted at outer Lineitem@0;
    // child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Customer @ 4 with Nation @ 6 (customer_nation , _) ;
    // R-Masks: Customer@4 is child of Orders@3 in H-SpanningCore tree (GYO join tree) rooted at outer Lineitem@0;
    // child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Orders @ 3 with Customer @ 4 (customer_key , _) ;
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@2', '@3', '@4', '@5', '@6'] broken by written
    // position (I4 last)
    Lineitem @ 0 (order_key , supplier_key , ship_date) ;
    // S-Connected: connected (shares ['supplier_key']); tie with ['@3'] broken by written position (I4 last)
    Supplier @ 2 (supplier_key , supplier_nation) ;
    // S-Connected: connected (shares ['order_key']); tie with ['@5'] broken by written position (I4 last)
    Orders @ 3 (order_key , customer_key) ;
    // S-Connected: connected (shares ['customer_key']); tie with ['@5'] broken by written position (I4 last)
    Customer @ 4 (customer_key , customer_nation) ;
    // S-Connected: connected (shares ['supplier_nation']); tie with ['@6'] broken by written position (I4 last)
    Nation @ 5 (supplier_nation , supplier_name) ;
    // S-Connected: connected (shares ['customer_nation'])
    Nation @ 6 (customer_nation , customer_name) ;
    // I2/a_i=0: ready filter, placed at first ready boundary
    where (supplier_name = @ (__cq_c_0) and customer_name = @ (__cq_c_1)) or (supplier_name = @ (__cq_c_2) and customer_name = @ (__cq_c_3)) ;
}
