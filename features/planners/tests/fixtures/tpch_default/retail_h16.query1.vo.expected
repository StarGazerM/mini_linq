// retail_h16.query1.vo.expected: expected default-route VO of TPC-H kernel retail_h16 (query1_main), derived
// from doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: O-EvidenceLe premise fails: no count for ['AllowedKinds'] -> O_Prefix(Connected),Coarse
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself at their first ready boundary; membership follows from the bound prefix.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Query ; relation Part (p_partkey : i64 [0] , p_brand : StringCode [1] in [0] (data . dictionaries . domain ("p_brand")) , p_type : StringCode [1] , p_size : i32 [2]) ; relation Partsupp (ps_partkey : i64 [0] , ps_suppkey : i64 [0]) ; relation AllowedKinds (kind : StringCode [1]) ; relation BadSupplier (suppkey : i64 [0]) ; relation answer (part_key : i64 [0] , suppkey : i64 [0]) ; answer (part_key , suppkey) : - Part (part_key , brand , kind , size) , AllowedKinds (kind) , where brand != (__cq_c_0) , if [49 , 14 , 23 , 45 , 19 , 3 , 36 , 9] . contains (size) , Partsupp (part_key , suppkey) , ! BadSupplier (suppkey) capture { domain __cq_c_0 : StringCode in [0] (data . dictionaries . domain ("p_brand")) = exact ("Brand#45") ; } ;
valuation {
    // O-Restrict/H-Local: restriction of clause 2 on Part@0 heads the scope (H-Local order)
    restrict Part @ 0 where brand != @ (__cq_c_0) ;
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@1', '@4'] broken by written position (I4 last)
    Part @ 0 (part_key , brand , kind , size) ;
    // I2/a_i=0: ready filter, placed at first ready boundary
    if [49 , 14 , 23 , 45 , 19 , 3 , 36 , 9] . contains (size) ;
    // I2/a_i=0: ready filter, placed at first ready boundary
    AllowedKinds @ 1 (kind) ;
    // S-Connected: connected (shares ['part_key'])
    Partsupp @ 4 (part_key , suppkey) ;
    // I2/a_i=0: ready filter, placed at first ready boundary
    ! BadSupplier (suppkey) ;
}
