// retail_d19.query0.vo.expected: expected default-route VO of TPC-H kernel retail_d19 (query0_main), derived
// from doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: O-EvidenceLe: no dominating functional root (w=Lineitem@0; F=[]) ->
// O_Prefix(Connected),Coarse
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself and nothing is drained: no `check`/`after` markers.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Query ; relation Lineitem (l_orderkey : i64 [0] , l_partkey : i64 [0] , l_suppkey : i64 [0]) ; relation Orders (o_orderkey : i64 [0] , o_custkey : i64 [0] , o_orderdate : Date [1]) ; relation Part (p_partkey : i64 [0]) ; relation Customer (c_custkey : i64 [0] , c_nationkey : i32 [2]) ; relation Nation (n_nationkey : i32 [2] , n_name : cq_load :: StringCode [3] in [0] (dictionaries . domain ("n_name"))) ; relation Supplier (s_suppkey : i64 [0]) ; relation answer (order_key : i64 [0] , part_key : i64 [0] , customer_key : i64 [0] , supplier_key : i64 [0]) ; answer (order_key , part_key , customer_key , supplier_key) : - Lineitem (order_key , part_key , supplier_key) , Orders (order_key , customer_key , order_date) , where order_date >= (start) , where order_date < (end) , Part (part_key) , Customer (customer_key , nation_key) , Nation (nation_key , __cq_6_1) , where __cq_6_1 == (__cq_c_0) , Supplier (supplier_key) capture { domain __cq_c_0 : cq_load :: StringCode in [0] (dictionaries . domain ("n_name")) = exact ("UNITED STATES") ; } ;
valuation evidence from "TPC-H dbgen SF1 row counts (DuckDB tpch dbgen(sf=1), equal to the GPU SF1 manifest); TPC-H primary keys" { count Lineitem = 6001215 ; count Orders = 1500000 ; key Orders [o_orderkey] ; count Part = 200000 ; key Part [p_partkey] ; count Customer = 150000 ; key Customer [c_custkey] ; count Nation = 25 ; key Nation [n_nationkey] ; count Supplier = 10000 ; key Supplier [s_suppkey] ; } {
    // O-Restrict/H-Local: restriction of clause 2 on Orders@1 heads the scope (H-Local order)
    restrict Orders @ 1 where order_date >= @ (start) ;
    // O-Restrict/H-Local: restriction of clause 3 on Orders@1 heads the scope (H-Local order)
    restrict Orders @ 1 where order_date < @ (end) ;
    // O-Restrict/H-Local: restriction of clause 7 on Nation@6 heads the scope (H-Local order)
    restrict Nation @ 6 where __cq_6_1 = @ (__cq_c_0) ;
    // R-Masks: Nation@6 is child of Customer@5 in H-SpanningCore tree (GYO join tree) rooted at outer Lineitem@0;
    // child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Customer @ 5 with Nation @ 6 (nation_key , _) ;
    // R-Masks: Customer@5 is child of Orders@1 in H-SpanningCore tree (GYO join tree) rooted at outer Lineitem@0;
    // child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Orders @ 1 with Customer @ 5 (customer_key , _) ;
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@1', '@4', '@5', '@6', '@8'] broken by written
    // position (I4 last)
    Lineitem @ 0 (order_key , part_key , supplier_key) ;
    // I2/a_i=0: ready filter, placed at first ready boundary. DIFFERS: producer prints `check after [1]`
    // (I2-drainage provenance of its pre-drain rank, which lacks a_i)
    Part @ 4 (part_key) ;
    // I2/a_i=0: ready filter, placed at first ready boundary. DIFFERS: producer prints `check after [1 , 5 , 6]`
    // (I2-drainage provenance of its pre-drain rank, which lacks a_i)
    Supplier @ 8 (supplier_key) ;
    // S-Connected: connected (shares ['order_key'])
    Orders @ 1 (order_key , customer_key , order_date) ;
    // S-Connected: connected (shares ['customer_key'])
    Customer @ 5 (customer_key , nation_key) ;
    // S-Connected: connected (shares ['nation_key'])
    Nation @ 6 (nation_key , __cq_6_1) ;
}
