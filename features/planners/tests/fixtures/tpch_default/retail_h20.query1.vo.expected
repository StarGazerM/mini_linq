// retail_h20.query1.vo.expected: expected default-route VO of TPC-H kernel retail_h20 (query1_main), derived
// from doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: O-EvidenceLe premise fails: no count for ['ForestNames', 'Shipped'] ->
// O_Prefix(Connected),Coarse
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself and nothing is drained: no `check`/`after` markers.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Query ; relation Part (p_partkey : i64 [0] , p_name : StringCode [1]) ; relation ForestNames (name : StringCode [1]) ; relation Partsupp (ps_partkey : i64 [0] , ps_suppkey : i64 [0] , ps_availqty : i64 [0]) ; relation Shipped (part_key : i64 [0] , supplier_key : i64 [0] , quantity_units : i64 [0]) ; relation Supplier (s_suppkey : i64 [0] , s_nationkey : i32 [2] , s_name : StringCode [1] , s_address : StringCode [1]) ; relation Nation (n_nationkey : i32 [2] , n_name : StringCode [1] in [0] (data . dictionaries . domain ("n_name"))) ; relation answer (supplier_name : StringCode [1] , address : StringCode [1]) ; answer (supplier_name , address) : - Part (part_key , part_name) , ForestNames (part_name) , Partsupp (part_key , supplier_key , available) , Shipped (part_key , supplier_key , quantity_units) , if i128 :: from (* available) * 200 > i128 :: from (* quantity_units) , Supplier (supplier_key , nation_key , supplier_name , address) , Nation (nation_key , nation_name) , where nation_name == (__cq_c_0) capture { domain __cq_c_0 : StringCode in [0] (data . dictionaries . domain ("n_name")) = exact ("CANADA") ; } ;
valuation evidence from "TPC-H dbgen SF1 row counts (DuckDB tpch dbgen(sf=1), equal to the GPU SF1 manifest); TPC-H primary keys" { count Part = 200000 ; key Part [p_partkey] ; count Partsupp = 800000 ; key Partsupp [ps_partkey , ps_suppkey] ; count Supplier = 10000 ; key Supplier [s_suppkey] ; count Nation = 25 ; key Nation [n_nationkey] ; } {
    // O-Restrict/H-Local: restriction of clause 7 on Nation@6 heads the scope (H-Local order)
    restrict Nation @ 6 where nation_name = @ (__cq_c_0) ;
    // R-Masks: Nation@6 is child of Supplier@5 in H-SpanningCore tree (GYO join tree) rooted at outer Part@0; child
    // subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Supplier @ 5 with Nation @ 6 (nation_key , _) ;
    // R-Masks: Supplier@5 is child of Shipped@3 in H-SpanningCore tree (GYO join tree) rooted at outer Part@0; child
    // subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Shipped @ 3 with Supplier @ 5 (supplier_key , _ , _ , _) ;
    // R-Masks: Shipped@3 is child of Partsupp@2 in H-SpanningCore tree (GYO join tree) rooted at outer Part@0; child
    // subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Partsupp @ 2 with Shipped @ 3 (part_key , supplier_key , _) ;
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@1', '@2', '@3', '@5', '@6'] broken by written
    // position (I4 last)
    Part @ 0 (part_key , part_name) ;
    // I2/a_i=0: ready filter, placed at first ready boundary
    ForestNames @ 1 (part_name) ;
    // S-Connected: connected (shares ['part_key']); tie with ['@3'] broken by written position (I4 last)
    Partsupp @ 2 (part_key , supplier_key , available) ;
    // S-Connected: connected (shares ['part_key', 'supplier_key']); tie with ['@5'] broken by written position (I4
    // last)
    Shipped @ 3 (part_key , supplier_key , quantity_units) ;
    // I2/a_i=0: ready filter, placed at first ready boundary
    if i128 :: from (* available) * 200 > i128 :: from (* quantity_units) ;
    // S-Connected: connected (shares ['supplier_key'])
    Supplier @ 5 (supplier_key , nation_key , supplier_name , address) ;
    // S-Connected: connected (shares ['nation_key'])
    Nation @ 6 (nation_key , nation_name) ;
}
