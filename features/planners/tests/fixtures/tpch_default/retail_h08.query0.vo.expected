// retail_h08.query0.vo.expected: expected default-route VO of TPC-H kernel retail_h08 (query0_main), derived
// from doc/formal independently of the producer.
// Route: default (the par route records the identical VO). Plan-Prefix with the R-TpchEvidence options (SF1
// counts, primary keys whose columns are all declared); r = Masks.
// Ordering decision: O-EvidenceLe: no dominating functional root (w=Lineitem@0; F=[]) ->
// O_Prefix(Connected),Coarse
// Prefix(Connected)/Coarse rank (passes.tex:197-199, 214-215, 326-327): atoms (a_i,1,[s_i=0],0,i), constraints
// (a_i,0,0,0,i), other nonatoms (a_i,0,0,1,i); a_i=[O_i not subset of B] first, so ready filters (I2) are placed
// by the scheduler itself at their first ready boundary; membership follows from the bound prefix.
// Restrictions: O-Restrict/H-Local + E-Domain at the scope head; Masks: R-Masks over H-SpanningCore rooted at
// the outer stream, children first (CK-Masks ChildrenFirst; sibling order by subtree rank then written clause).
struct Query ; relation Lineitem (l_orderkey : i64 [0] , l_partkey : i64 [0] , l_suppkey : i64 [0]) ; relation Part (p_partkey : i64 [0] , p_type : cq_load :: StringCode [1] in [0] (dictionaries . domain ("p_type"))) ; relation Supplier (s_suppkey : i64 [0] , s_nationkey : i32 [2]) ; relation Orders (o_orderkey : i64 [0] , o_custkey : i64 [0] , o_orderdate : Date [3]) ; relation Customer (c_custkey : i64 [0] , c_nationkey : i32 [2]) ; relation Nation (n_nationkey : i32 [2] , n_regionkey : i32 [2]) ; relation Region (r_regionkey : i32 [2] , r_name : cq_load :: StringCode [1] in [1] (dictionaries . domain ("r_name"))) ; relation answer (order_key : i64 [0] , part_key : i64 [0] , supplier_key : i64 [0]) ; answer (order_key , part_key , supplier_key) : - Lineitem (order_key , part_key , supplier_key) , Part (part_key , __cq_1_1) , where __cq_1_1 == (__cq_c_0) , Supplier (supplier_key , supplier_nation) , Orders (order_key , customer_key , order_date) , where order_date in (start) ..= (end) , Customer (customer_key , customer_nation) , Nation (customer_nation , customer_region) , Region (customer_region , __cq_7_1) , where __cq_7_1 == (__cq_c_1) , Nation (supplier_nation , _supplier_region) capture { domain __cq_c_0 : cq_load :: StringCode in [0] (dictionaries . domain ("p_type")) = exact ("ECONOMY ANODIZED STEEL") ; domain __cq_c_1 : cq_load :: StringCode in [1] (dictionaries . domain ("r_name")) = exact ("AMERICA") ; } ;
valuation {
    // O-Restrict/H-Local: restriction of clause 2 on Part@1 heads the scope (H-Local order)
    restrict Part @ 1 where __cq_1_1 = @ (__cq_c_0) ;
    // O-Restrict/H-Local: restriction of clause 5 on Orders@4 heads the scope (H-Local order)
    restrict Orders @ 4 where order_date between @ (start) and @ (end) ;
    // O-Restrict/H-Local: restriction of clause 9 on Region@8 heads the scope (H-Local order)
    restrict Region @ 8 where __cq_7_1 = @ (__cq_c_1) ;
    // R-Masks: Region@8 is child of Nation@7 in H-SpanningCore tree (GYO join tree) rooted at outer Lineitem@0;
    // child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Nation @ 7 with Region @ 8 (customer_region , _) ;
    // R-Masks: Nation@7 is child of Customer@6 in H-SpanningCore tree (GYO join tree) rooted at outer Lineitem@0;
    // child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Customer @ 6 with Nation @ 7 (customer_nation , _) ;
    // R-Masks: Customer@6 is child of Orders@4 in H-SpanningCore tree (GYO join tree) rooted at outer Lineitem@0;
    // child subtree carries a local filter (f<3, H-FilterRank); children first
    reduce Orders @ 4 with Customer @ 6 (customer_key , _) ;
    // S-Connected: no connected ready atom (I3 vacuous); tie with ['@1', '@3', '@4', '@6', '@7', '@8', '@10'] broken
    // by written position (I4 last)
    Lineitem @ 0 (order_key , part_key , supplier_key) ;
    // S-Connected: connected (shares ['part_key']); tie with ['@3', '@4'] broken by written position (I4 last)
    Part @ 1 (part_key , __cq_1_1) ;
    // S-Connected: connected (shares ['supplier_key']); tie with ['@4'] broken by written position (I4 last)
    Supplier @ 3 (supplier_key , supplier_nation) ;
    // S-Connected: connected (shares ['order_key']); tie with ['@10'] broken by written position (I4 last)
    Orders @ 4 (order_key , customer_key , order_date) ;
    // S-Connected: connected (shares ['customer_key']); tie with ['@10'] broken by written position (I4 last)
    Customer @ 6 (customer_key , customer_nation) ;
    // S-Connected: connected (shares ['customer_nation']); tie with ['@10'] broken by written position (I4 last)
    Nation @ 7 (customer_nation , customer_region) ;
    // S-Connected: connected (shares ['customer_region']); tie with ['@10'] broken by written position (I4 last)
    Region @ 8 (customer_region , __cq_7_1) ;
    // S-Connected: connected (shares ['supplier_nation'])
    Nation @ 10 (supplier_nation , _supplier_region) ;
}
