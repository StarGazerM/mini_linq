relational { relation R (first : i32 , second : i32) ; relation S (first : i32 , second : i32) ; relation T (first : i32 , second : i32) ; r0 = rename S { first - > b , second - > c } ; r1 = rename T { first - > c , second - > a } ; r2 = natural_join r0 with r1 ; r3 = rename R { first - > a , second - > b } ; r4 = natural_join r2 with r3 ; r5 = project r4 keep { a , b , c } ; output r5 as answer (a , b , c) ; }
