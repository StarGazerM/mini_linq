relational { relation Edge (src : i32 , dst : i32) ; r0 = rename Edge { src - > a , dst - > b } ; r1 = project r0 keep { a } ; r2 = natural_join r1 with r0 ; r3 = rename Edge { src - > b , dst - > c } ; r4 = natural_join r2 with r3 ; r5 = rename Edge { src - > d , dst - > c } ; r6 = natural_join r4 with r5 ; r7 = project r6 keep { a , d } ; output r7 as answer (a , d) ; }
