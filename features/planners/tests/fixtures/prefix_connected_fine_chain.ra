relational { relation Edge (src : i32 , dst : i32) ; r0 = rename Edge @ 0 { src - > a , dst - > b } ; r1 = project r0 keep { a } ; r2 = natural_join r1 with r0 ; r3 = rename Edge @ 1 { src - > b , dst - > c } ; r4 = semijoin r2 with r3 ; r5 = natural_join r4 with r3 ; r6 = rename Edge @ 2 { src - > d , dst - > c } ; r7 = semijoin r5 with r6 ; r8 = natural_join r7 with r6 ; r9 = project r8 keep { a , d } ; output r9 as answer (a , d) ; }
