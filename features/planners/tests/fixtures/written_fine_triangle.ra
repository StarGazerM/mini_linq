relational { relation R (first : i32 , second : i32) ; relation S (first : i32 , second : i32) ; relation T (first : i32 , second : i32) ; r0 = rename R { first - > a , second - > b } ; r1 = project r0 keep { a } ; r2 = natural_join r1 with r0 ; r3 = rename S { first - > b , second - > c } ; r4 = natural_join r2 with r3 ; r5 = rename T { first - > c , second - > a } ; r6 = natural_join r4 with r5 ; r7 = project r6 keep { a , b , c } ; output r7 as answer (a , b , c) ; }
