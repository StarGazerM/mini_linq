relational { relation Edge (src : i32 , dst : i32) ; r0 = rename Edge @ 0 { src - > a , dst - > b } ; r1 = project r0 keep { a } ; r2 = rename Edge @ 1 { src - > b , dst - > c } ; r3 = project r2 keep { b } ; r4 = natural_join r1 with r3 ; r5 = natural_join r4 with r0 ; r6 = rename Edge @ 2 { src - > d , dst - > c } ; r7 = project r6 keep { c } ; r8 = natural_join r5 with r7 ; r9 = natural_join r8 with r2 ; r10 = natural_join r9 with r6 ; r11 = project r10 keep { a , d } ; output r11 as answer (a , d) ; }
