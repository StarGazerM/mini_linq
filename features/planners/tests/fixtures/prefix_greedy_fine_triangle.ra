relational { relation R (first : i32 , second : i32) ; relation S (first : i32 , second : i32) ; relation T (first : i32 , second : i32) ; r0 = rename R @ 0 { first - > a , second - > b } ; r1 = project r0 keep { a } ; r2 = rename T @ 2 { first - > c , second - > a } ; r3 = semijoin r1 with r2 ; r4 = natural_join r3 with r0 ; r5 = rename S @ 1 { first - > b , second - > c } ; r6 = semijoin r4 with r5 ; r7 = natural_join r6 with r5 ; r8 = natural_join r7 with r2 ; r9 = project r8 keep { a , b , c } ; output r9 as answer (a , b , c) ; }
