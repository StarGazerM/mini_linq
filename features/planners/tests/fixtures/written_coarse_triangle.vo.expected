// written_coarse_triangle.vo.expected: expected VO derived by hand from doc/formal (ir_vo.tex WF-VO-*,
// passes.tex I1-I5 and the planner O-/S-/R- rules), independently of the producer.
// Every step is preceded by the rule that fixes its position; RULE GAP marks a position the rules leave open,
// with the tie-break used.
// Planner written,coarse = O_{Written,Coarse} (lib.rs facade table; Plan-Graph uses the same order).
// c0=R(a,b), c1=S(b,c), c2=T(c,a)
// S-Written: sequence = drain_I2([0,1,2]); O-Coarse: one full subatom per atom. No predicates, no reductions.
struct Triangle ; relation R (first : i32 [0] , second : i32 [0]) ; relation S (first : i32 [0] , second : i32 [0]) ; relation T (first : i32 [0] , second : i32 [0]) ; answer (a , b , c) : - R (a , b) , S (b , c) , T (c , a) ;
valuation {
    // S-Written position 0; introduces a,b
    R @ 0 (a , b) ;
    // S-Written position 1; introduces c
    S @ 1 (b , c) ;
    // S-Written position 2; filter (a,c bound); ready only after c, so already at its earliest point (I2 satisfied,
    // no drainage, no check marker)
    T @ 2 (c , a) ;
}
