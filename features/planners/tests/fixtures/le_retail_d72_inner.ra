relational { relation Lineitem (l_orderkey : i64 , l_partkey : i64 , l_suppkey : i64 , l_shipdate : Date , l_quantity : Decimal) ; relation Orders (o_orderkey : i64 , o_custkey : i64) ; relation PartSupp (ps_partkey : i64 , ps_suppkey : i64 , ps_availqty : i64) ; relation Supplier (s_suppkey : i64 , s_nationkey : i32) ; relation Part (p_partkey : i64) ; relation Customer (c_custkey : i64 , c_nationkey : i32) ; relation Nation (n_nationkey : i32) ; r0 = rename Lineitem @ 1 { l_orderkey - > order_key , l_partkey - > part_key , l_suppkey - > supplier_key , l_shipdate - > ship_date , l_quantity - > quantity } ; r1 = select r0 if (ship_date >= @ (start) , ship_date < @ (end)) ; r2 = select r1 if (quantity > @ (minimum)) ; r3 = rename PartSupp @ 5 { ps_partkey - > part_key , ps_suppkey - > supplier_key , ps_availqty - > available } ; r4 = select r3 if (available > 0) ; r5 = semijoin r2 with r4 ; r6 = rename Orders @ 0 { o_orderkey - > order_key , o_custkey - > customer_key } ; r7 = semijoin r6 with r5 ; r8 = rename Customer @ 9 { c_custkey - > customer_key , c_nationkey - > nation_key } ; r9 = semijoin r7 with r8 ; r10 = natural_join r9 with r5 ; r12 = rename Part @ 8 { p_partkey - > part_key } ; r13 = natural_join r10 with r12 ; r14 = rename Supplier @ 7 { s_suppkey - > supplier_key , s_nationkey - > nation_key } ; r15 = semijoin r13 with r14 ; r17 = natural_join r15 with r14 ; r18 = rename Nation @ 10 { n_nationkey - > nation_key } ; r19 = natural_join r17 with r18 ; r21 = natural_join r19 with r8 ; r23 = project r21 keep { nation_key , order_key , part_key , supplier_key } ; output r23 as answer (order_key , part_key , supplier_key , nation_key) ; }
