struct D72 ; relation Lineitem (l_orderkey : i64 [0] , l_partkey : i64 [0] , l_suppkey : i64 [0] , l_shipdate : Date [1] , l_quantity : Decimal [2]) ; relation Orders (o_orderkey : i64 [0] , o_custkey : i64 [0]) ; relation PartSupp (ps_partkey : i64 [0] , ps_suppkey : i64 [0] , ps_availqty : i64 [0]) ; relation Supplier (s_suppkey : i64 [0] , s_nationkey : i32 [3]) ; relation Part (p_partkey : i64 [0]) ; relation Customer (c_custkey : i64 [0] , c_nationkey : i32 [3]) ; relation Nation (n_nationkey : i32 [3]) ; answer (order_key , part_key , supplier_key , nation_key) : - Orders (order_key , customer_key) , Lineitem (order_key , part_key , supplier_key , ship_date , quantity) , where ship_date >= (start) , where ship_date < (end) , where quantity > (minimum) , PartSupp (part_key , supplier_key , available) , where available > 0 , Supplier (supplier_key , nation_key) , Part (part_key) , Customer (customer_key , nation_key) , Nation (nation_key) ; valuation { restrict Lineitem @ 1 where ship_date >= @ (start) ; restrict Lineitem @ 1 where ship_date < @ (end) ; restrict Lineitem @ 1 where quantity > @ (minimum) ; restrict PartSupp @ 5 where available > 0 ; reduce Lineitem @ 1 with PartSupp @ 5 (part_key , supplier_key , _) ; Orders @ 0 (order_key , customer_key) ; Lineitem @ 1 (order_key , _ , _ , _ , _) ; Customer @ 9 (customer_key , _) ; Lineitem @ 1 (order_key , part_key , supplier_key , ship_date , quantity) ; PartSupp @ 5 (part_key , supplier_key , _) ; Part @ 8 (part_key) ; Supplier @ 7 (supplier_key , _) ; PartSupp @ 5 (part_key , supplier_key , available) ; Supplier @ 7 (supplier_key , nation_key) ; Nation @ 10 (nation_key) ; Part @ 8 (part_key) ; Customer @ 9 (customer_key , nation_key) ; Nation @ 10 (nation_key) ; }
