valuation { restrict Lineitem @ 1 where ship_date >= @ (start) ; restrict Lineitem @ 1 where ship_date < @ (end) ; restrict Lineitem @ 1 where quantity > @ (minimum) ; restrict PartSupp @ 5 where available > 0 ; reduce Lineitem @ 1 with PartSupp @ 5 (part_key , supplier_key , _) ; Orders @ 0 (order_key , customer_key) ; Lineitem @ 1 (order_key , _ , _ , _ , _) ; Customer @ 9 (customer_key , _) ; Lineitem @ 1 (order_key , part_key , supplier_key , ship_date , quantity) ; PartSupp @ 5 (part_key , supplier_key , _) ; Part @ 8 (part_key) ; Supplier @ 7 (supplier_key , _) ; Part @ 8 (part_key) ; PartSupp @ 5 (part_key , supplier_key , available) ; Supplier @ 7 (supplier_key , nation_key) ; Nation @ 10 (nation_key) ; Customer @ 9 (customer_key , nation_key) ; Nation @ 10 (nation_key) ; }
