struct D72 ; relation Lineitem (l_orderkey : i64 , l_partkey : i64 , l_suppkey : i64 , l_shipdate : Date , l_quantity : Decimal) ; relation Orders (o_orderkey : i64 , o_custkey : i64) ; relation PartSupp (ps_partkey : i64 , ps_suppkey : i64 , ps_availqty : i64) ; relation Supplier (s_suppkey : i64 , s_nationkey : i32) ; relation Part (p_partkey : i64) ; relation Customer (c_custkey : i64 , c_nationkey : i32) ; relation Nation (n_nationkey : i32) ; answer (order_key , part_key , supplier_key , nation_key) : - Orders (order_key , customer_key) , Lineitem (order_key , part_key , supplier_key , ship_date , quantity) , if ship_date >= start , if ship_date < end , if quantity > minimum , PartSupp (part_key , supplier_key , available) , if available > 0 , Supplier (supplier_key , nation_key) , Part (part_key) , Customer (customer_key , nation_key) , Nation (nation_key) ; valuation { reduce Lineitem @ 1 with PartSupp @ 5 (part_key , supplier_key , _) ; Orders @ 0 (order_key , customer_key) ; Lineitem @ 1 (order_key , _ , _ , _ , _) ; Customer @ 9 (customer_key , _) ; Lineitem @ 1 (order_key , part_key , supplier_key , ship_date , quantity) ; PartSupp @ 5 (part_key , supplier_key , _) ; Part @ 8 (part_key) ; Supplier @ 7 (supplier_key , _) ; ship_date >= @ start ; ship_date < @ end ; quantity > @ minimum ; PartSupp @ 5 (part_key , supplier_key , available) ; available > 0 ; Supplier @ 7 (supplier_key , nation_key) ; Nation @ 10 (nation_key) ; Part @ 8 (part_key) ; Customer @ 9 (customer_key , nation_key) ; Nation @ 10 (nation_key) ; }
