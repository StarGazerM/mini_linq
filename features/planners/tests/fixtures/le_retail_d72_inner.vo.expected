// le_retail_d72_inner.vo.expected: expected VO derived by hand from doc/formal (ir_vo.tex WF-VO-*, passes.tex
// I1-I5 and the planner O-/S-/R- rules), independently of the producer.
// Every step is preceded by its ordering rule; deterministic tie-breaks are stated below.
// Planner le = Plan-Le: v = O_{Written,Coarse}; outer = written root (CK-Le auto); lookups R(b,_) at the first
// point their bound key is available, in GYO ear order; expansions as late as column demand or scope exit
// permits; then restrict, R_{None,Masks}.
// c0=Orders(order_key,customer_key), c1=Lineitem(order_key,part_key,supplier_key,ship_date,quantity), c2-c4
// where on Lineitem, c5=PartSupp(part_key,supplier_key,available), c6 where available>0,
// c7=Supplier(supplier_key,nation_key), c8=Part(part_key), c9=Customer(customer_key,nation_key),
// c10=Nation(nation_key)
// O-Restrict: c2-c4 target c1, c6 targets c5; restrictions at scope head in written predicate order.
// H-SpanningCore: GYO absorbs 5->1, 8->1, 10->7; core {0,1,7,9}; spanning core 0-1, 0-9, 1-7. Rooted at outer
// c0: 1->{5,7,8}, 7->10, 9.
// R-Masks: only filtered child subtree of a non-root clause is c5 (f=1) under c1 => red(1,5).
// GYO ear order: 5, 8, 10; core occurrences (1,7,9) follow in written position (O-LeEarOrder).
// Plan-Le runs before O-Restrict (w = R(restrict(le(v)))), so `where available > 0` (c6) still demands
// available: expand(c5) sits at c6's written-chain position.
// O-LeDemand: first use is the written-chain (v) position of the first later step whose
// key/free variables need the column; O-LeExit emits remaining expansions at scope exit
// in written order. I2 drainage moves a ready membership read to its first ready
// boundary. Membership is determined by the bound prefix, not phase-history syntax.
// Lookups are fresh partial reads R(b,_) at the first point their key is available.
struct D72 ; relation Lineitem (l_orderkey : i64 [0] , l_partkey : i64 [0] , l_suppkey : i64 [0] , l_shipdate : Date [1] , l_quantity : Decimal [2]) ; relation Orders (o_orderkey : i64 [0] , o_custkey : i64 [0]) ; relation PartSupp (ps_partkey : i64 [0] , ps_suppkey : i64 [0] , ps_availqty : i64 [0]) ; relation Supplier (s_suppkey : i64 [0] , s_nationkey : i32 [3]) ; relation Part (p_partkey : i64 [0]) ; relation Customer (c_custkey : i64 [0] , c_nationkey : i32 [3]) ; relation Nation (n_nationkey : i32 [3]) ; answer (order_key , part_key , supplier_key , nation_key) : - Orders (order_key , customer_key) , Lineitem (order_key , part_key , supplier_key , ship_date , quantity) , where ship_date >= (start) , where ship_date < (end) , where quantity > (minimum) , PartSupp (part_key , supplier_key , available) , where available > 0 , Supplier (supplier_key , nation_key) , Part (part_key) , Customer (customer_key , nation_key) , Nation (nation_key) ;
valuation {
    // O-Restrict c2 -> c1
    restrict Lineitem @ 1 where ship_date >= @ (start) ;
    // O-Restrict c3 -> c1
    restrict Lineitem @ 1 where ship_date < @ (end) ;
    // O-Restrict c4 -> c1
    restrict Lineitem @ 1 where quantity > @ (minimum) ;
    // O-Restrict c6 -> c5
    restrict PartSupp @ 5 where available > 0 ;
    // R-Masks red(1,5)
    reduce Lineitem @ 1 with PartSupp @ 5 (part_key , supplier_key , _) ;
    // outer: written root
    Orders @ 0 (order_key , customer_key) ;
    // lookup(c1): key order_key; before c9 by written position
    Lineitem @ 1 (order_key , _ , _ , _ , _) ;
    // lookup(c9): key customer_key available after outer
    Customer @ 9 (customer_key , _) ;
    // expand(c1): demanded at c8's (drained) written position
    Lineitem @ 1 (order_key , part_key , supplier_key , ship_date , quantity) ;
    // lookup(c5): ear order 5
    PartSupp @ 5 (part_key , supplier_key , _) ;
    // lookup(c8): ear order 8
    Part @ 8 (part_key) ;
    // lookup(c7): core, after ears
    Supplier @ 7 (supplier_key , _) ;
    // expand(c8): scope exit; I2 drainage to first ready point crosses expand(c5) and expand(c7)
    Part @ 8 (part_key) ;
    // expand(c5): available demanded by c6 (before O-Restrict)
    PartSupp @ 5 (part_key , supplier_key , available) ;
    // expand(c7): nation_key demanded at c9's written position
    Supplier @ 7 (supplier_key , nation_key) ;
    // lookup(c10): key nation_key
    Nation @ 10 (nation_key) ;
    // expand(c9): scope exit in written order (9 before 10), filter, no introduction crossed
    Customer @ 9 (customer_key , nation_key) ;
    // expand(c10): full row
    Nation @ 10 (nation_key) ;
}
