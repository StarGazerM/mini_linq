relational { relation R (first : i32 , second : i32) ; relation S (first : i32 , second : i32) ; relation T (first : i32 , second : i32) ; r0 = rename T { first - > c , second - > a } ; r1 = project r0 keep { a } ; r2 = rename R { first - > a , second - > b } ; r3 = semijoin r1 with r2 ; r4 = rename S { first - > b , second - > c } ; r5 = project r4 keep { b } ; r6 = natural_join r3 with r5 ; r7 = natural_join r6 with r2 ; r8 = natural_join r7 with r4 ; r9 = natural_join r8 with r0 ; r10 = project r9 keep { a , b , c } ; output r10 as answer (a , b , c) ; }
