struct H05 ; relation Customer (c_custkey : i64 , c_nationkey : i32) ; relation Orders (o_orderkey : i64 , o_custkey : i64 , o_orderdate : Date) ; relation Lineitem (l_orderkey : i64 , l_suppkey : i64) ; relation Supplier (s_suppkey : i64 , s_nationkey : i32) ; relation Nation (n_nationkey : i32 , n_regionkey : i32) ; relation Region (r_regionkey : i32 , r_name : String) ; answer (order_key , supplier_key , nation_key) : - Lineitem (order_key , supplier_key) , Orders (order_key , customer_key , order_date) , if order_date >= start , if order_date < end , Customer (customer_key , nation_key) , Nation (nation_key , region_key) , Region (region_key , __cq_6_1) , if __cq_6_1 == "ASIA" , Supplier (supplier_key , nation_key) ; valuation { reduce Nation @ 5 with Region @ 6 (region_key , _) ; reduce Customer @ 4 with Nation @ 5 (nation_key , _) ; reduce Orders @ 1 with Customer @ 4 (customer_key , _) ; Lineitem @ 0 (order_key , supplier_key) ; Orders @ 1 (order_key , _ , _) ; Supplier @ 8 (supplier_key , _) ; Orders @ 1 (order_key , customer_key , order_date) ; Customer @ 4 (customer_key , _) ; order_date >= @ start ; order_date < @ end ; Customer @ 4 (customer_key , nation_key) ; Nation @ 5 (nation_key , _) ; Nation @ 5 (nation_key , region_key) ; Region @ 6 (region_key , _) ; Region @ 6 (region_key , __cq_6_1) ; __cq_6_1 = "ASIA" ; Supplier @ 8 (supplier_key , nation_key) ; }
