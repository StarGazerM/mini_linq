valuation { restrict Orders @ 1 where order_date >= @ (start) ; restrict Orders @ 1 where order_date < @ (end) ; reduce Nation @ 5 with Region @ 6 (region_key) ; reduce Customer @ 4 with Nation @ 5 (nation_key , _) ; reduce Orders @ 1 with Customer @ 4 (customer_key , _) ; Lineitem @ 0 (order_key , supplier_key) ; Orders @ 1 (order_key , _ , _) ; Supplier @ 7 (supplier_key , _) ; Orders @ 1 (order_key , customer_key , order_date) ; Customer @ 4 (customer_key , _) ; Customer @ 4 (customer_key , nation_key) ; Nation @ 5 (nation_key , _) ; Supplier @ 7 (supplier_key , nation_key) ; Nation @ 5 (nation_key , region_key) ; Region @ 6 (region_key) ; Region @ 6 (region_key) ; }
