struct H05 ; relation Customer (c_custkey : i64 [0] , c_nationkey : i32 [1]) ; relation Orders (o_orderkey : i64 [0] , o_custkey : i64 [0] , o_orderdate : Date [2]) ; relation Lineitem (l_orderkey : i64 [0] , l_suppkey : i64 [0]) ; relation Supplier (s_suppkey : i64 [0] , s_nationkey : i32 [1]) ; relation Nation (n_nationkey : i32 [1] , n_regionkey : i32 [1]) ; relation Region (r_regionkey : i32 [1] , r_name : StringCode [3]) ; answer (order_key , supplier_key , nation_key) : - Lineitem (order_key , supplier_key) , Orders (order_key , customer_key , order_date) , where order_date >= (start) , where order_date < (end) , Customer (customer_key , nation_key) , Nation (nation_key , region_key) , Region (region_key , "ASIA") , Supplier (supplier_key , nation_key) ; valuation { restrict Orders @ 1 where order_date >= @ (start) ; restrict Orders @ 1 where order_date < @ (end) ; reduce Nation @ 5 with Region @ 6 (region_key) ; reduce Customer @ 4 with Nation @ 5 (nation_key , _) ; reduce Orders @ 1 with Customer @ 4 (customer_key , _) ; Lineitem @ 0 (order_key , supplier_key) ; Orders @ 1 (order_key , _ , _) ; Supplier @ 7 (supplier_key , _) ; Orders @ 1 (order_key , customer_key , order_date) ; Customer @ 4 (customer_key , _) ; Customer @ 4 (customer_key , nation_key) ; Nation @ 5 (nation_key , _) ; Supplier @ 7 (supplier_key , nation_key) ; Nation @ 5 (nation_key , region_key) ; Region @ 6 (region_key) ; Region @ 6 (region_key) ; }
