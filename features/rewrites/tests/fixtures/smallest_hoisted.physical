physical {
    relation R(first: i32, second: i32);
    relation S(first: i32, second: i32);
    relation T(first: i32, second: i32);
    r0 = pipe rename R @0 { first -> a, second -> b };
    r1 = pipe project r0 keep { a };
    r2 = pipe probe first [a] r1, r0;
    r3 = pipe rename S @1 { first -> b, second -> c };
    r5 = pipe rename T @2 { first -> c, second -> a };
    r4 = pipe probe smallest [b] r2, r3;
    r6 = pipe probe first [a, c] r4, r5;
    r7 = pipe canon project r6 keep { a, b, c };
    return r7 as answer(a, b, c);
}
