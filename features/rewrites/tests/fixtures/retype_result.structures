structures {
    providers {
        btree_map_grouped = ::std::collections::BTreeMap<_, ::std::vec::Vec<_>> { reads [exact, membership, ordered], supports [keys], build typed, shared };
        hash_index = ::cq_storage::HashIndex<'_, _, _> { reads [exact, membership], supports [keys], build typed, join_filter };
        hash_set = ::cq_storage::HashSet<_> { reads [membership], build typed, accounting keys, shared };
        trie = ::cq_storage::Trie<'_, _, _> { reads [exact, membership], build typed, nested 2 };
        host_scan = ::core::iter::Map<_, _> { reads [], build typed };
        vec = ::std::vec::Vec<_> { reads [], build typed, accounting rows };
        sort = ::cq_storage::dedup::Sort { reads [distinct, comparator_rows], build inferred, shared };
        replacement = Replacement<'_, _, _> { reads [exact, range, membership], build typed };
    }
    o = @btree_map_grouped as ::std::collections::BTreeMap<_, ::std::vec::Vec<_>> [x];
    r = @replacement as Replacement<'_, _, _> [x];
    s = @hash_set as ::cq_storage::HashSet<_> [x];
    t = @trie(@hash_index as ::cq_storage::HashIndex<'_, _, _>) as ::cq_storage::Trie<'_, _, ::cq_storage::HashIndex<'_, _, _>> [x][y];
    l host scan = @host_scan as ::core::iter::Map<_, _> [];
    l host result(j) = @btree_map_grouped as ::std::collections::BTreeMap<_, ::std::vec::Vec<_>> [x];
    o rows = @vec as ::std::vec::Vec<_>;
    o host scan = @host_scan as ::core::iter::Map<_, _> [];
    r rows = @vec as ::std::vec::Vec<_>;
    r host scan = @host_scan as ::core::iter::Map<_, _> [];
    s rows = @vec as ::std::vec::Vec<_>;
