structures {
    providers {
        btree_map_grouped = ::std::collections::BTreeMap<_, ::std::vec::Vec<_>> { reads [exact, membership, ordered], supports [keys], build macro, shared };
        hash_index = ::cq_storage::HashIndex<'_, _, _> { reads [exact, membership], supports [keys], build macro, join_filter };
        hash_set = ::cq_storage::HashSet<_> { reads [membership], build macro, accounting keys, shared };
        host_scan = ::core::iter::Map<_, _> { reads [], build macro };
        vec = ::std::vec::Vec<_> { reads [], build macro, accounting rows };
        sort = ::cq_storage::dedup::Sort { reads [distinct], build inferred, shared };
        replacement = Replacement<'_, _, Inner<_>> { reads [exact, range, membership], build macro };
    }
    o = @btree_map_grouped as ::std::collections::BTreeMap<_, ::std::vec::Vec<_>> [x];
    r = @hash_index as ::cq_storage::HashIndex<'_, _, _> [x];
    s = @hash_set as ::cq_storage::HashSet<_> [x];
    t = @replacement as Replacement<'_, _, Inner<_>> [x][y];
    l host scan = @host_scan as ::core::iter::Map<_, _> [];
    l host result(j) = @btree_map_grouped as ::std::collections::BTreeMap<_, ::std::vec::Vec<_>> [x];
    o rows = @vec as ::std::vec::Vec<_>;
    o host scan = @host_scan as ::core::iter::Map<_, _> [];
    r rows = @vec as ::std::vec::Vec<_>;
    r host scan = @host_scan as ::core::iter::Map<_, _> [];
    s rows = @vec as ::std::vec::Vec<_>;
    s host scan = @host_scan as ::core::iter::Map<_, _> [];
    t rows = @vec as ::std::vec::Vec<_>;
    t host scan = @host_scan as ::core::iter::Map<_, _> [];
    out rows = @sort as ::cq_storage::dedup::Sort; out canon = rows;
}
