physical {
    relation L(a: i32);
    relation R(a: i32, b: i32);
    relation S(a: i32);
    relation T(a: i32, b: i32);
    l = pipe rename L @0 { a -> x };
    o = let rename L @1 { a -> x };
    r = let rename R @2 { a -> x, b -> y };
    s = let rename S @3 { a -> x };
    t = let rename T @4 { a -> x, b -> y };
    j = pipe merge [x] l, o;
    n = pipe semi eager [x] j, t;
    p = pipe probe first [x] n, r;
    m = pipe semi eager [x] p, s;
    q = pipe probe first [x, y] m, t;
    out = pipe canon project q keep { x, y };
    return out as answer(x, y);
}
