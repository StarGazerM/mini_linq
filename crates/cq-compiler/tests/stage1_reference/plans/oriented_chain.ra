struct OrientedChain;
relation Edge(src: i32, dst: i32);
answer(a, d) :- Edge(a, b), Edge(b, c), Edge(d, c).
relational {
    first = rename Edge {src -> a, dst -> b};
    second = rename Edge {src -> b, dst -> c};
    third = rename Edge {src -> d, dst -> c};
    prefix = natural_join first with second;
    live = project prefix keep {a, c};
    joined = natural_join live with third;
    result = project joined keep {a, d};
    output result as answer(a, d).
}
