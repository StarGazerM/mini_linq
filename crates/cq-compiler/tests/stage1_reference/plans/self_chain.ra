struct SelfChain;
relation Road(src: i32, dst: i32);
answer(a, c) :- Road(a, b), Road(b, c).
relational {
    first = rename Road {src -> a, dst -> b};
    second = rename Road {src -> b, dst -> c};
    paths = natural_join first with second;
    result = project paths keep {a, c};
    output result as answer(a, c).
}
