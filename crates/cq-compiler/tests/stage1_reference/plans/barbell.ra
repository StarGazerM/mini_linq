struct Barbell;
relation R(first: i32, second: i32);
relation S(first: i32, second: i32);
relation T(first: i32, second: i32);
relation Bridge(first: i32, second: i32);
relation U(first: i32, second: i32);
relation V(first: i32, second: i32);
relation W(first: i32, second: i32);
answer(x, y, z, u, v, w) :-
    R(x, y), S(y, z), T(x, z), Bridge(x, u), U(u, v), V(v, w), W(u, w);
relational {
    r = rename R {first -> x, second -> y};
    s = rename S {first -> y, second -> z};
    t = rename T {first -> x, second -> z};
    bridge = rename Bridge {first -> x, second -> u};
    u0 = rename U {first -> u, second -> v};
    v0 = rename V {first -> v, second -> w};
    w0 = rename W {first -> u, second -> w};
    rs = natural_join r with s;
    left_triangle = natural_join rs with t;
    uv = natural_join u0 with v0;
    right_triangle = natural_join uv with w0;
    reached = natural_join left_triangle with bridge;
    result = natural_join reached with right_triangle;
    output result as answer(x, y, z, u, v, w);
}
