struct CartesianFirst;
relation R(first: i32, second: i32);
relation S(first: i32, second: i32);
relation T(first: i32, second: i32);
answer(a, d) :- R(a, b), S(b, c), T(c, d).
relational {
    r = rename R {first -> a, second -> b};
    s = rename S {first -> b, second -> c};
    t = rename T {first -> c, second -> d};
    product = natural_join r with t;
    checked = natural_join product with s;
    result = project checked keep {a, d};
    output result as answer(a, d).
}
