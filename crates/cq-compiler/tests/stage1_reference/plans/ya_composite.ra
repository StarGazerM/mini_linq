// Root S has separators {a,b} with R and {b,c} with T;
struct YaComposite;
relation R(first: i32, second: i32, value: i32);
relation S(first: i32, second: i32, third: i32);
relation T(first: i32, second: i32, value: i32);
answer(u, v) :- R(a, b, u), S(a, b, c), T(b, c, v);
relational {
    r0 = rename R {first -> a, second -> b, value -> u};
    s0 = rename S {first -> a, second -> b, third -> c};
    t0 = rename T {first -> b, second -> c, value -> v};
    up_r = natural_join s0 with r0;
    s1 = project up_r keep {a, b, c};
    up_t = natural_join s1 with t0;
    s2 = project up_t keep {a, b, c};
    down_r = natural_join r0 with s2;
    r1 = project down_r keep {a, b, u};
    down_t = natural_join t0 with s2;
    t1 = project down_t keep {b, c, v};
    sr = natural_join s2 with r1;
    live = project sr keep {b, c, u};
    joined = natural_join live with t1;
    result = project joined keep {u, v};
    output result as answer(u, v);
}
