struct Existential;
relation R(value: i32);
relation S(first: i32, second: i32);
answer(x) :- R(x), S(y, z).
relational {
    r = rename R {value -> x};
    s = rename S {first -> y, second -> z};
    exists = project s keep {};
    result = natural_join r with exists;
    output result as answer(x).
}
