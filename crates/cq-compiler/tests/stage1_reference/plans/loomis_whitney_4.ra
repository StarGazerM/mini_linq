struct LoomisWhitneyFour;
relation ABC(first: i32, second: i32, third: i32);
relation BCD(first: i32, second: i32, third: i32);
relation ACD(first: i32, second: i32, third: i32);
relation ABD(first: i32, second: i32, third: i32);
answer(a, b, c, d) :- ABC(a, b, c), BCD(b, c, d), ACD(a, c, d), ABD(a, b, d).
relational {
    abc = rename ABC {first -> a, second -> b, third -> c};
    bcd = rename BCD {first -> b, second -> c, third -> d};
    acd = rename ACD {first -> a, second -> c, third -> d};
    abd = rename ABD {first -> a, second -> b, third -> d};
    joined = natural_join abc with bcd;
    checked_acd = natural_join joined with acd;
    result = natural_join checked_acd with abd;
    output result as answer(a, b, c, d).
}
