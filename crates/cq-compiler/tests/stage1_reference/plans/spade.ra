struct Spade;
relation R(first: i32, second: i32);
relation S(first: i32, second: i32);
relation T(first: i32, second: i32);
relation H(first: i32, second: i32);
answer(x, y, z, w) :- R(x, y), S(y, z), T(x, z), H(x, w);
relational {
    r = rename R {first -> x, second -> y};
    s = rename S {first -> y, second -> z};
    t = rename T {first -> x, second -> z};
    h = rename H {first -> x, second -> w};
    rs = natural_join r with s;
    triangle = natural_join rs with t;
    result = natural_join triangle with h;
    output result as answer(x, y, z, w);
}
