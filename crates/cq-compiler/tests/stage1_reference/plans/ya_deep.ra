// A depth-three join tree rooted at R; Semijoins use their RA definition;
struct YaDeep;
relation R(first: i32, second: i32);
relation S(first: i32, second: i32);
relation T(first: i32, second: i32);
relation U(first: i32, second: i32);
answer(a, e) :- R(a, b), S(b, c), T(c, d), U(d, e);
relational {
    r0 = rename R {first -> a, second -> b};
    s0 = rename S {first -> b, second -> c};
    t0 = rename T {first -> c, second -> d};
    u0 = rename U {first -> d, second -> e};
    up_t = natural_join t0 with u0;
    t1 = project up_t keep {c, d};
    up_s = natural_join s0 with t1;
    s1 = project up_s keep {b, c};
    up_r = natural_join r0 with s1;
    r1 = project up_r keep {a, b};
    down_s = natural_join s1 with r1;
    s2 = project down_s keep {b, c};
    down_t = natural_join t1 with s2;
    t2 = project down_t keep {c, d};
    down_u = natural_join u0 with t2;
    u1 = project down_u keep {d, e};
    rs = natural_join r1 with s2;
    live_c = project rs keep {a, c};
    rst = natural_join live_c with t2;
    live_d = project rst keep {a, d};
    joined = natural_join live_d with u1;
    result = project joined keep {a, e};
    output result as answer(a, e);
}
