struct ReturnTrip;
relation Road(src: i32, dst: i32);
answer(a) :- Road(a, b), Road(b, a).
relational {
    outward = rename Road {src -> a, dst -> b};
    inward = rename Road {src -> b, dst -> a};
    both = natural_join outward with inward;
    result = project both keep {a};
    output result as answer(a).
}
