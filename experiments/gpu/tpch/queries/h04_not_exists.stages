program h04_not_exists {
    input Orders(o_orderkey: i64, o_orderdate: Date) = table(orders);
    input Lineitem(l_orderkey: i64, l_commitdate: Date, l_receiptdate: Date) = table(lineitem);
    input LateLineitem(order_key: i64) = host uses [Lineitem] rust {
        Lineitem.iter()
            .filter(|row| row.1 < row.2).map(|row| (row.0,)).collect::<Vec<(i64,)>>()
    };
    operand start: Date = date { Date::load("1993-07-01").expect("authored ISO date") };
    operand end: Date = date { Date::load("1993-10-01").expect("authored ISO date") };
    stage s0 {
        inputs {
            Orders = Orders;
            Lineitem = Lineitem;
            LateLineitem = LateLineitem;
        }
        captures [start, end];
        evidence {}
        cq {
            struct Query;
            relation Orders(o_orderkey: i64, o_orderdate: Date);
            relation Lineitem(l_orderkey: i64, l_commitdate: Date, l_receiptdate: Date);
            relation LateLineitem(order_key: i64);
            relation answer(order_key: i64);
            answer(order_key) :-
                Orders(order_key, order_date), where order_date >= start && order_date < end,
                !LateLineitem(order_key);
        }
    }
    terminal {
        from s0 project [column(0)] dictionaries [];
    }
}
