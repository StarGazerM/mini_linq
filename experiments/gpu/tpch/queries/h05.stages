program h05 {
    domain RegionName = dictionary(region.r_name);
    input Customer(c_custkey: i64, c_nationkey: i32) = table(customer);
    input Orders(o_orderkey: i64, o_custkey: i64, o_orderdate: Date) = table(orders);
    input Lineitem(l_orderkey: i64, l_suppkey: i64) = table(lineitem);
    input Supplier(s_suppkey: i64, s_nationkey: i32) = table(supplier);
    input Nation(n_nationkey: i32, n_regionkey: i32) = table(nation);
    input Region(r_regionkey: i32, r_name: cq_load::StringCode in RegionName) = table(region);
    operand start: Date = date { Date::load("1994-01-01").expect("authored ISO date") };
    operand end: Date = date { Date::load("1995-01-01").expect("authored ISO date") };
    stage s0 {
        inputs {
            Customer = Customer;
            Orders = Orders;
            Lineitem = Lineitem;
            Supplier = Supplier;
            Nation = Nation;
            Region = Region;
        }
        captures [start, end];
        evidence {}
        cq {
            struct Query;
            relation Customer(c_custkey: i64, c_nationkey: i32);
            relation Orders(o_orderkey: i64, o_custkey: i64, o_orderdate: Date);
            relation Lineitem(l_orderkey: i64, l_suppkey: i64);
            relation Supplier(s_suppkey: i64, s_nationkey: i32);
            relation Nation(n_nationkey: i32, n_regionkey: i32);
            relation Region(r_regionkey: i32, r_name: cq_load::StringCode);
            relation answer(order_key: i64, supplier_key: i64, nation_key: i32);
            answer(order_key, supplier_key, nation_key) :-
                Lineitem(order_key, supplier_key),
                Orders(order_key, customer_key, order_date), where order_date >= start && order_date < end,
                Customer(customer_key, nation_key), Nation(nation_key, region_key), Region(region_key, "ASIA"),
                Supplier(supplier_key, nation_key);
        }
    }
    terminal {
        from s0 project [column(0), column(1), column(2)] dictionaries [];
    }
}
