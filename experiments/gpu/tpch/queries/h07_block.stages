program h07_block {
    domain NationName = dictionary(nation.n_name);
    input Supplier(s_suppkey: i64, s_nationkey: i32) = table(supplier);
    input Lineitem(l_orderkey: i64, l_suppkey: i64, l_shipdate: Date) = table(lineitem);
    input Orders(o_orderkey: i64, o_custkey: i64) = table(orders);
    input Customer(c_custkey: i64, c_nationkey: i32) = table(customer);
    input Nation(n_nationkey: i32, n_name: cq_load::StringCode in NationName) = table(nation);
    operand start: Date = date { Date::load("1995-01-01").expect("authored ISO date") };
    operand end: Date = date { Date::load("1996-12-31").expect("authored ISO date") };
    stage s0 {
        inputs {
            Supplier = Supplier;
            Lineitem = Lineitem;
            Orders = Orders;
            Customer = Customer;
            Nation = Nation;
        }
        captures [start, end];
        evidence {}
        cq {
            struct Query;
            relation Supplier(s_suppkey: i64, s_nationkey: i32);
            relation Lineitem(l_orderkey: i64, l_suppkey: i64, l_shipdate: Date);
            relation Orders(o_orderkey: i64, o_custkey: i64);
            relation Customer(c_custkey: i64, c_nationkey: i32);
            relation Nation(n_nationkey: i32, n_name: cq_load::StringCode);
            relation answer(order_key: i64, supplier_nation: i32, customer_nation: i32);
            answer(order_key, supplier_nation, customer_nation) :-
                Lineitem(order_key, supplier_key, ship_date), where ship_date >= start && ship_date <= end,
                Supplier(supplier_key, supplier_nation),
                Orders(order_key, customer_key), Customer(customer_key, customer_nation),
                { Nation(supplier_nation, "FRANCE"), Nation(customer_nation, "GERMANY") }
                | { Nation(supplier_nation, "GERMANY"), Nation(customer_nation, "FRANCE") };
        }
    }
    terminal {
        from s0 project [column(0), column(1), column(2)] dictionaries [];
    }
}
