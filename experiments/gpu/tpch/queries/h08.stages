program h08 {
    domain PartType = dictionary(part.p_type);
    domain RegionName = dictionary(region.r_name);
    input Lineitem(l_orderkey: i64, l_partkey: i64, l_suppkey: i64) = table(lineitem);
    input Part(p_partkey: i64, p_type: cq_load::StringCode in PartType) = table(part);
    input Supplier(s_suppkey: i64, s_nationkey: i32) = table(supplier);
    input Orders(o_orderkey: i64, o_custkey: i64, o_orderdate: Date) = table(orders);
    input Customer(c_custkey: i64, c_nationkey: i32) = table(customer);
    input Nation(n_nationkey: i32, n_regionkey: i32) = table(nation);
    input Region(r_regionkey: i32, r_name: cq_load::StringCode in RegionName) = table(region);
    operand start: Date = date { Date::load("1995-01-01").expect("authored ISO date") };
    operand end: Date = date { Date::load("1996-12-31").expect("authored ISO date") };
    stage s0 {
        inputs {
            Lineitem = Lineitem;
            Part = Part;
            Supplier = Supplier;
            Orders = Orders;
            Customer = Customer;
            Nation = Nation;
            Region = Region;
        }
        captures [start, end];
        evidence {}
        cq {
            struct Query;
            relation Lineitem(l_orderkey: i64, l_partkey: i64, l_suppkey: i64);
            relation Part(p_partkey: i64, p_type: cq_load::StringCode);
            relation Supplier(s_suppkey: i64, s_nationkey: i32);
            relation Orders(o_orderkey: i64, o_custkey: i64, o_orderdate: Date);
            relation Customer(c_custkey: i64, c_nationkey: i32);
            relation Nation(n_nationkey: i32, n_regionkey: i32);
            relation Region(r_regionkey: i32, r_name: cq_load::StringCode);
            relation answer(order_key: i64, part_key: i64, supplier_key: i64);
            answer(order_key, part_key, supplier_key) :-
                Lineitem(order_key, part_key, supplier_key),
                Part(part_key, "ECONOMY ANODIZED STEEL"),
                Supplier(supplier_key, supplier_nation),
                Orders(order_key, customer_key, order_date), where order_date >= start && order_date <= end,
                Customer(customer_key, customer_nation), Nation(customer_nation, customer_region),
                Region(customer_region, "AMERICA"),
                Nation(supplier_nation, _supplier_region);
        }
    }
    terminal {
        from s0 project [column(0), column(1), column(2)] dictionaries [];
    }
}
