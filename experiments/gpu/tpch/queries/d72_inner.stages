program d72_inner {
    input Lineitem(l_orderkey: i64, l_partkey: i64, l_suppkey: i64, l_shipdate: Date, l_quantity: Decimal) = table(lineitem);
    input Orders(o_orderkey: i64, o_custkey: i64) = table(orders);
    input PartSupp(ps_partkey: i64, ps_suppkey: i64, ps_availqty: i64) = table(partsupp);
    input Supplier(s_suppkey: i64, s_nationkey: i32) = table(supplier);
    input Part(p_partkey: i64) = table(part);
    input Customer(c_custkey: i64, c_nationkey: i32) = table(customer);
    input Nation(n_nationkey: i32) = table(nation);
    operand start: Date = date { Date::load("1995-01-01").expect("authored ISO date") };
    operand end: Date = date { Date::load("1995-04-01").expect("authored ISO date") };
    operand minimum: Decimal = rust { Decimal::from_scaled(2000).expect("20.00") };
    stage s0 {
        inputs {
            Lineitem = Lineitem;
            Orders = Orders;
            PartSupp = PartSupp;
            Supplier = Supplier;
            Part = Part;
            Customer = Customer;
            Nation = Nation;
        }
        captures [start, end, minimum];
        evidence {}
        cq {
            struct Query;
            relation Lineitem(l_orderkey: i64, l_partkey: i64, l_suppkey: i64, l_shipdate: Date, l_quantity: Decimal);
            relation Orders(o_orderkey: i64, o_custkey: i64);
            relation PartSupp(ps_partkey: i64, ps_suppkey: i64, ps_availqty: i64);
            relation Supplier(s_suppkey: i64, s_nationkey: i32);
            relation Part(p_partkey: i64);
            relation Customer(c_custkey: i64, c_nationkey: i32);
            relation Nation(n_nationkey: i32);
            relation answer(order_key: i64, part_key: i64, supplier_key: i64, nation_key: i32);
            answer(order_key, part_key, supplier_key, nation_key) :-
                Orders(order_key, customer_key),
                Lineitem(order_key, part_key, supplier_key, ship_date, quantity),
                where ship_date >= start && ship_date < end, where quantity > minimum,
                PartSupp(part_key, supplier_key, available), where available > 0,
                Supplier(supplier_key, nation_key), Part(part_key), Customer(customer_key, nation_key),
                Nation(nation_key);
        }
    }
    terminal {
        from s0 project [column(0), column(1), column(2), column(3)] dictionaries [];
    }
}
