program d19 {
    domain NationName = dictionary(nation.n_name);
    input Lineitem(l_orderkey: i64, l_partkey: i64, l_suppkey: i64) = table(lineitem);
    input Orders(o_orderkey: i64, o_custkey: i64, o_orderdate: Date) = table(orders);
    input Part(p_partkey: i64) = table(part);
    input Customer(c_custkey: i64, c_nationkey: i32) = table(customer);
    input Nation(n_nationkey: i32, n_name: cq_load::StringCode in NationName) = table(nation);
    input Supplier(s_suppkey: i64) = table(supplier);
    operand start: Date = date { Date::load("1995-01-01").expect("authored ISO date") };
    operand end: Date = date { Date::load("1995-04-01").expect("authored ISO date") };
    stage s0 {
        inputs {
            Lineitem = Lineitem;
            Orders = Orders;
            Part = Part;
            Customer = Customer;
            Nation = Nation;
            Supplier = Supplier;
        }
        captures [start, end];
        evidence {}
        cq {
            struct Query;
            relation Lineitem(l_orderkey: i64, l_partkey: i64, l_suppkey: i64);
            relation Orders(o_orderkey: i64, o_custkey: i64, o_orderdate: Date);
            relation Part(p_partkey: i64);
            relation Customer(c_custkey: i64, c_nationkey: i32);
            relation Nation(n_nationkey: i32, n_name: cq_load::StringCode);
            relation Supplier(s_suppkey: i64);
            relation answer(order_key: i64, part_key: i64, customer_key: i64, supplier_key: i64);
            answer(order_key, part_key, customer_key, supplier_key) :-
                Lineitem(order_key, part_key, supplier_key),
                Orders(order_key, customer_key, order_date), where order_date >= start && order_date < end,
                Part(part_key), Customer(customer_key, nation_key),
                Nation(nation_key, "UNITED STATES"),
                Supplier(supplier_key);
        }
    }
    terminal {
        from s0 project [column(0), column(1), column(2), column(3)] dictionaries [];
    }
}
