j0 = natural_join l with r;
j1 = natural_join m with s;
indexes {
    i0 = @r[0];
    i1 = @s[0];
}
uses {
    j0.right = i0;
    j1.right = i1;
}
physical {
    relations {
        l = ext::slice_rows;
        m = ext::slice_rows;
        r = ext::hash_relation;
        s = ext::sorted_relation;
        j0 = ext::borrowed_pairs;
        j1 = ext::borrowed_pairs;
    }
    indexes {
        i0 = ext::hash_relation;
        i1 = ext::sorted_relation;
    }
    lowerings {
        j0 = ext::indexed_join;
        j1 = ext::indexed_join;
    }
}
