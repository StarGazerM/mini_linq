struct Fuzz;
relation r0(c0: i32, c1: i32, c2: i32);
relation r1(c0: i32, c1: i32);
relation answer(c0: i32, c1: i32);
answer(((-(v1.to_owned())) * (v3.to_owned() % 1)), v3) :- r1(v1, 3), r1(v2, v3), r0(v4, 1, -3), if !(((v1.to_owned() != 1) && ((v1.to_owned() + 1) > 0))), if !(((v4.to_owned() > -3) && ((v3.to_owned() + 0) > 0))), where (v1 == 1 || v1 == 2 || v1 == -2), where v3 == v4;
