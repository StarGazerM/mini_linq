sequence
{
    r0 = tile 64 rows r0; r1 = map r1 r0; r2 = map r2 r1; r3 = map r3 r2; r4 =
    store group r4 r3; __sequence_output = store flatten tile 64 r4; output
    count;
} graded tasks
{
    r0 at host.pool.task; r1 at host.pool.task; r2 at host.pool.task; r3 at
    host.pool.task; r4 at host.pool; __sequence_output at host.pool;
}
