{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MiniLinq: Explain query",
            "type": "process",
            "command": "cargo",
            "args": [
                "xtask",
                "explain",
                "${input:miniLinqExplainCase}",
                "--through",
                "${input:miniLinqExplainStage}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Notes: Build entire site",
            "type": "process",
            "command": "node",
            "args": [
                "build-site.mjs"
            ],
            "options": {
                "cwd": "${workspaceFolder}/doc/notes"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ],
    "inputs": [
        {
            "id": "miniLinqExplainCase",
            "type": "promptString",
            "description": "Catalog query case",
            "default": "triangle"
        },
        {
            "id": "miniLinqExplainStage",
            "type": "pickString",
            "description": "Stop after compiler stage",
            "options": [
                "cq",
                "relational-plan",
                "index-requirements"
            ],
            "default": "index-requirements"
        }
    ]
}
