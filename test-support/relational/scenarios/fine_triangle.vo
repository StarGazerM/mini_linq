struct Triangle;
relation R(first: i32, second: i32);
relation S(first: i32, second: i32);
relation T(first: i32, second: i32);
answer(a, b, c) :- R(a, b), S(__cq_1_0, c), b = __cq_1_0, T(__cq_2_0, __cq_2_1), c = __cq_2_0, a = __cq_2_1;
valuation {
    R@0(a, _);
    R@0(a, b);
    S@1(__cq_1_0, _);
    S@1(__cq_1_0, c);
    b = __cq_1_0;
    T@3(__cq_2_0, _);
    T@3(__cq_2_0, __cq_2_1);
    c = __cq_2_0;
    a = __cq_2_1;
}
