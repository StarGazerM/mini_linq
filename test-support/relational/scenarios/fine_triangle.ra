relational {
    relation R(first: i32, second: i32);
    relation S(first: i32, second: i32);
    relation T(first: i32, second: i32);
    r0 = rename R { first -> a, second -> b };
    r1 = project r0 keep { a };
    r2 = natural_join r1 with r0;
    r3 = rename S { first -> b, second -> c };
    r4 = semijoin r2 with r3;
    r5 = natural_join r4 with r3;
    r6 = rename T { first -> c, second -> a };
    r7 = semijoin r5 with r6;
    r8 = natural_join r7 with r6;
    r9 = project r8 keep { a, b, c };
    output r9 as answer(a, b, c);
}
