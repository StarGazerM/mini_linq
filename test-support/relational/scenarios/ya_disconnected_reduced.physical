physical {
    relation R(value: i32);
    relation S(first: i32, second: i32);
    r0 = alias rename S { first -> y, second -> z };
    r1 = let rename R { value -> x };
    r2 = let semi[] r0, r1;
    r3 = pipe semi[] r1, r2;
    r4 = pipe probe[] r3, r2;
    r5 = pipe canon project r4 keep { x };
    return r5 as answer(x);
}
