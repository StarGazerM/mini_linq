struct TernaryGuard;
relation A(first: i32, second: i32);
relation B(first: i32, second: i32);
relation C(first: i32, second: i32);
relation Stock(depot: i32, item: i32, day: i32);
answer(d, i, t) :- A(d, i), B(__cq_1_0, t), i = __cq_1_0, C(__cq_2_0, __cq_2_1), d = __cq_2_0, t = __cq_2_1, Stock(__cq_3_0, __cq_3_1, __cq_3_2), d = __cq_3_0, i = __cq_3_1, t = __cq_3_2;
valuation {
    A@0(d, i);
    B@1(__cq_1_0, t);
    i = __cq_1_0;
    C@3(__cq_2_0, __cq_2_1);
    d = __cq_2_0;
    t = __cq_2_1;
    Stock@6(__cq_3_0, __cq_3_1, __cq_3_2);
    d = __cq_3_0;
    i = __cq_3_1;
    t = __cq_3_2;
}
