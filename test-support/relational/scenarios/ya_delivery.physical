physical {
    relation D(driver_id: i32, depot_id: i32);
    relation S(depot_id: i32, item_id: i32);
    relation N(job_id: i32, item_id: i32);
    r0 = alias rename D { driver_id -> driver, depot_id -> depot };
    r1 = let rename S { depot_id -> depot, item_id -> item };
    r2 = pipe probe[depot] r0, r1;
    r3 = let rename N { job_id -> job, item_id -> item };
    r4 = pipe probe[item] r2, r3;
    r5 = pipe canon project r4 keep { driver, job };
    return r5 as answer(driver, job);
}
