struct YaDeep;
relation R(first: i32, second: i32);
relation S(first: i32, second: i32);
relation T(first: i32, second: i32);
relation U(first: i32, second: i32);
answer(a, e) :- R(a, b), S(__cq_1_0, c), b = __cq_1_0, T(__cq_2_0, d), c = __cq_2_0, U(__cq_3_0, e), d = __cq_3_0;
valuation {
    R@0(a, b);
    S@1(__cq_1_0, c);
    b = __cq_1_0;
    T@3(__cq_2_0, d);
    c = __cq_2_0;
    U@5(__cq_3_0, e);
    d = __cq_3_0;
}
