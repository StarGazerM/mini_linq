physical {
    relation R(first: i32, second: i32, value: i32);
    relation S(first: i32, second: i32, third: i32);
    relation T(first: i32, second: i32, value: i32);
    r0 = alias rename S { first -> a, second -> b, third -> c };
    r1 = let rename R { first -> a, second -> b, value -> u };
    r2 = let semi[a, b] r0, r1;
    r3 = alias rename T { first -> b, second -> c, value -> v };
    r4 = let semi[b, c] r3, r2;
    r5 = let semi[b, c] r2, r4;
    r6 = pipe semi[a, b] r1, r5;
    r7 = pipe probe[a, b] r6, r5;
    r8 = pipe probe[b, c] r7, r4;
    r9 = pipe canon project r8 keep { u, v };
    return r9 as answer(u, v);
}
