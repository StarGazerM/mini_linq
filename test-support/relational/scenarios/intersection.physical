physical {
    relation R(first: i32, second: i32);
    relation S(first: i32, second: i32);
    r0 = alias rename R { first -> x, second -> y };
    r1 = let rename S { first -> x, second -> y };
    r2 = pipe probe[x, y] r0, r1;
    r3 = pipe canon project r2 keep { x, y };
    return r3 as answer(x, y);
}
