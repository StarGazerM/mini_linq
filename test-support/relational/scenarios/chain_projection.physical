physical {
    relation R(first: i32, second: i32);
    relation S(first: i32, second: i32);
    relation T(first: i32, second: i32);
    r0 = pipe rename R { first -> a, second -> b };
    r1 = pipe rename S { first -> b, second -> c };
    r2 = pipe probe[b] r0, r1;
    r3 = pipe rename T { first -> c, second -> d };
    r4 = pipe probe[c] r2, r3;
    r5 = pipe canon project r4 keep { a, d };
    return r5 as answer(a, d);
}
