physical {
    relation ABC(first: i32, second: i32, third: i32);
    relation BCD(first: i32, second: i32, third: i32);
    relation ACD(first: i32, second: i32, third: i32);
    relation ABD(first: i32, second: i32, third: i32);
    r0 = alias rename ABC { first -> a, second -> b, third -> c };
    r1 = let rename BCD { first -> b, second -> c, third -> d };
    r2 = pipe probe[b, c] r0, r1;
    r3 = let rename ACD { first -> a, second -> c, third -> d };
    r4 = pipe probe[a, c, d] r2, r3;
    r5 = let rename ABD { first -> a, second -> b, third -> d };
    r6 = pipe probe[a, b, d] r4, r5;
    r7 = pipe canon project r6 keep { a, b, c, d };
    return r7 as answer(a, b, c, d);
}
