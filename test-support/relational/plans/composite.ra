struct Composite;
relation R(first: i32, second: i32, value: i32);
relation S(first: i32, second: i32, value: i32);
answer(x, y) :- R(a, b, x), S(b, a, y);
relational {
    r = rename R {first -> a, second -> b, value -> x};
    s = rename S {first -> b, second -> a, value -> y};
    joined = natural_join r with s;
    result = project joined keep {x, y};
    output result as answer(x, y);
}
