struct TernaryGuard;
relation A(first: i32, second: i32);
relation B(first: i32, second: i32);
relation C(first: i32, second: i32);
relation Stock(depot: i32, item: i32, day: i32);
answer(d, i, t) :- A(d, i), B(i, t), C(d, t), Stock(d, i, t);
relational {
    a0 = rename A {first -> d, second -> i};
    b0 = rename B {first -> i, second -> t};
    c0 = rename C {first -> d, second -> t};
    stock = rename Stock {depot -> d, item -> i, day -> t};
    ab = natural_join a0 with b0;
    pairs = natural_join ab with c0;
    result = natural_join pairs with stock;
    output result as answer(d, i, t);
}
